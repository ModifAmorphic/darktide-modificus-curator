<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Modificus.Curator.UI</RootNamespace>
    <AssemblyName>Modificus.Curator</AssemblyName>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Velopack (install + auto-update). Gated behind CuratorUseVelopack so only
    Velopack-packaged builds reference it: a Windows install or a Linux
    AppImage. The standalone Linux tarball and dev builds do not set it.
    Velopack's Linux output is an AppImage, paired with a per-user installer.
    The matching CURATOR_VELOPACK compilation symbol gates the
    VelopackApp.Build().Run() startup hook in Program.cs. Set the property at
    publish/pack time (e.g. -p:CuratorUseVelopack=true).
  -->
  <PropertyGroup Condition="'$(CuratorUseVelopack)' == 'true'">
    <DefineConstants>$(DefineConstants);CURATOR_VELOPACK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(CuratorUseVelopack)' == 'true'">
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!--
    Exposes the internal NxmModDownloadHandler implementation to the test
    assembly so it can be unit-tested directly (the handler is constructed by
    the composition root via a factory; tests construct it directly with a
    pass-through UI-thread seam). The implementation stays internal.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Modificus.Curator.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/app-icon.png" />
    <!--
      Quantico Bold (SIL Open Font License 1.1), embedded as an Avalonia
      resource and referenced by the Launch action via
      avares://Modificus.Curator/Assets/fonts/Quantico-Bold.ttf#Quantico.
      Do not alter, subset, or rename the TTF. Its human-readable license ships as
      the sibling OFL.txt None item below.
    -->
    <AvaloniaResource Include="Assets/fonts/Quantico-Bold.ttf" />
    <!--
      Copied to both build output and publish output so the SIL OFL 1.1 license +
      copyright ship with the app (the font itself is bundled in the assembly).
    -->
    <None Include="Assets/fonts/OFL.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <!--
      Explicit Avalonia.X11 reference so Program.cs can construct
      X11PlatformOptions (WmClass) directly. Avalonia.Desktop brings
      Avalonia.X11 in at runtime but excludes it from compile-time refs, so the
      options type is not otherwise visible to code.
    -->
    <PackageReference Include="Avalonia.X11" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\config\Modificus.Curator.Config.csproj" />
    <ProjectReference Include="..\relay-client\Modificus.Curator.RelayClient.csproj" />
    <ProjectReference Include="..\general\Modificus.Curator.General.csproj" />
    <ProjectReference Include="..\integrations\Modificus.Curator.Integrations.csproj" />
    <ProjectReference Include="..\nxm\Modificus.Curator.Nxm.csproj" />
    <ProjectReference Include="..\profiles\Modificus.Curator.Profiles.csproj" />
    <ProjectReference Include="..\steam\Modificus.Curator.Steam.csproj" />
  </ItemGroup>

</Project>
