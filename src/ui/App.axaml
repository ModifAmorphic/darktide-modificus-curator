<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Modificus.Curator.UI.Localization"
             x:Class="Modificus.Curator.UI.App"
             RequestedThemeVariant="Default">

    <!--
      Window.FontSize cascades to all child controls via property inheritance, so
      a single Window style applies the global font scale across every window.
      The DynamicResource picks up live changes when AppFontSize is overwritten.
    -->
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!--
              App-owned caution brushes. Avalonia's FluentTheme ships no
              SystemControl*Caution* keys (only Base*/Error*/Accent*/Chrome*),
              so a DynamicResource to the SystemControl*Caution* names resolves
              to null and renders nothing. These are the app-owned replacements;
              do not revert to the SystemControl*Caution* names. ThemeDictionaries
              Light/Dark resolve per the active theme and DynamicResource recolors
              on a theme switch automatically.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CuratorCautionBrush" Color="#8A6D00" />
                    <SolidColorBrush x:Key="CuratorCautionBackgroundBrush" Color="#FFF1CC" />
                    <!--
                      App self-update status-strip pill. Explicit Light values so
                      the notice stays legible regardless of the platform accent
                      (SteamOS can supply a low-contrast SystemAccentColor). The
                      link + dismiss are styled off these in MainWindow.axaml.
                    -->
                    <SolidColorBrush x:Key="CuratorUpdateNoticeBackgroundBrush" Color="#E5F8FA" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeHoverBrush" Color="#D2F0F3" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticePressedBrush" Color="#BDE5E9" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeForegroundBrush" Color="#004B53" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeBorderBrush" Color="#007C89" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeFocusBrush" Color="#004B53" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CuratorCautionBrush" Color="#E2C019" />
                    <SolidColorBrush x:Key="CuratorCautionBackgroundBrush" Color="#3D3200" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeBackgroundBrush" Color="#0C343B" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeHoverBrush" Color="#124650" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticePressedBrush" Color="#185864" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeForegroundBrush" Color="#D7FAFD" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeBorderBrush" Color="#42D3DF" />
                    <SolidColorBrush x:Key="CuratorUpdateNoticeFocusBrush" Color="#72E4EC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!--
              Launch action iron-and-rust palette. Theme-independent (a branded
              primary action): a dark gunmetal face, off-white text, and a rust
              lower edge in every theme. Defined as plain resources so they
              resolve to the same value in Light and Dark.
            -->
            <SolidColorBrush x:Key="CuratorLaunchFaceBrush" Color="#30383F" />
            <SolidColorBrush x:Key="CuratorLaunchFaceHoverBrush" Color="#3A444C" />
            <SolidColorBrush x:Key="CuratorLaunchFacePressedBrush" Color="#242B31" />
            <SolidColorBrush x:Key="CuratorLaunchTextBrush" Color="#F4EEE9" />
            <SolidColorBrush x:Key="CuratorLaunchRustBrush" Color="#D86638" />
            <SolidColorBrush x:Key="CuratorLaunchRustHoverBrush" Color="#E47742" />
            <SolidColorBrush x:Key="CuratorLaunchRustPressedBrush" Color="#C95A32" />
            <SolidColorBrush x:Key="CuratorLaunchFaceDisabledBrush" Color="#3A3F44" />
            <SolidColorBrush x:Key="CuratorLaunchRustDisabledBrush" Color="#5A4036" />
            <SolidColorBrush x:Key="CuratorLaunchTextDisabledBrush" Color="#8C8F92" />
            <SolidColorBrush x:Key="CuratorLaunchFocusBrush" Color="#57E8F6" />
            <!--
              The LocalizationService is exposed app-wide as a resource so every
              view binds localized strings through one source + one instance:
                <TextBlock Text="{Binding [App_Title], Source={StaticResource Loc}}" />
              The instance is replaced with the real DI singleton at startup (in
              App.OnFrameworkInitializationCompleted), so the XAML-time instance is
              only a design-time placeholder.
            -->
            <loc:LocalizationService x:Key="Loc" />
            <!--
              Base UI font size, in pixels. The PreferencesService applies the user's
              font scale by overwriting this resource; the Window style above binds
              Window.FontSize to it, and child controls inherit. Default = unscaled
              (overwritten at startup from the loaded config).
            -->
            <x:Double x:Key="AppFontSize">14</x:Double>
            <!--
              Status-strip font size, in pixels. Smaller than the body font (the
              status strip is a secondary, low-emphasis line). The PreferencesService
              overwrites it with the same scale as AppFontSize; MainWindow's status
              TextBlock binds FontSize to it. Default = unscaled (overwritten at
              startup from the loaded config).
            -->
            <x:Double x:Key="AppStatusFontSize">12</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
