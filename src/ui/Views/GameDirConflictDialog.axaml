<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Modificus.Curator.UI.Views"
        xmlns:behaviors="using:Modificus.Curator.UI.Behaviors"
        x:Class="Modificus.Curator.UI.Views.GameDirConflictDialog"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        Width="480" MinWidth="320"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        behaviors:EscapeClosesBehavior.IsEnabled="True"
        WindowStartupLocation="CenterOwner">

  <!--
    Mirrors the UnsavedChangesDialog shape: WindowDecorations="None" with
    DialogTitleBar (drag region + drawn close X). The close X + ESC (via
    EscapeClosesBehavior) + a window close all map to the
    GameDirConflictChoice.Cancel default, so they share the explicit Cancel
    button's contract. SizeToContent="Height" honors font scale at show time
    in Avalonia 12.x.

    Two buttons, left to right: Cancel, Rename. Rename is the accent
    affordance.
  -->
  <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1">
    <Grid RowDefinitions="Auto,*">

      <views:DialogTitleBar Grid.Row="0" />

      <Border Grid.Row="1" Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap" />
            <TextBlock Text="{ReflectionBinding [GameDir_MessageFootnote], Source={StaticResource Loc}}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right">
            <Button Name="CancelButton"
                    Content="{ReflectionBinding [GameDir_CancelButton], Source={StaticResource Loc}}"
                    Click="Cancel_Click"
                    MinWidth="80" />
            <Button Name="RenameButton"
                    Content="{ReflectionBinding [GameDir_RenameButton], Source={StaticResource Loc}}"
                    Click="Rename_Click"
                    Classes="accent"
                    MinWidth="80" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
