<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modificus.Curator.UI.ViewModels"
             x:Class="Modificus.Curator.UI.Views.LaunchSettingsEditorView"
             x:DataType="vm:LaunchSettingsEditorViewModel">

  <!--
    Host-neutral launch-settings editor content (no ScrollViewer: the host owns
    scrolling so the editor composes cleanly into a modal body or a page-level
    scroll host without nesting). Two sections (env-var rows + game-arg rows,
    each add/remove) with inline localized validation, the game-startup
    (Skip Splash) + logging (Enable Lua Logs) toggles, and the static
    next-launch hint. No footer: Save/Cancel/error are host-owned.
  -->
  <StackPanel Spacing="16">

    <!-- Environment variables section -->
    <StackPanel Spacing="6">
      <TextBlock Text="{ReflectionBinding [LaunchSettings_EnvHeader], Source={StaticResource Loc}}"
                 FontWeight="SemiBold" />
      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="4">
        <StackPanel Spacing="2" Margin="6">
          <ItemsControl ItemsSource="{Binding EnvironmentVariables}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EnvVarRow">
                <StackPanel Spacing="2" Margin="0,2">
                  <Grid ColumnDefinitions="*,*,Auto" Margin="0,2">
                    <TextBox Grid.Column="0"
                             Text="{Binding Name, Mode=TwoWay}"
                             PlaceholderText="{ReflectionBinding [LaunchSettings_EnvNamePlaceholder], Source={StaticResource Loc}}"
                             MinWidth="120" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Value, Mode=TwoWay}"
                             PlaceholderText="{ReflectionBinding [LaunchSettings_EnvValuePlaceholder], Source={StaticResource Loc}}" />
                    <Button Grid.Column="2"
                            ToolTip.Tip="{ReflectionBinding [LaunchSettings_RemoveTooltip], Source={StaticResource Loc}}"
                            Click="RemoveEnv_Click"
                            CommandParameter="{Binding}"
                            MinWidth="36" Margin="6,0,0,0"
                            VerticalAlignment="Center">
                      <!-- Material "close" cross (24x24 source): drawn geometry,
                           inherits the button foreground. -->
                      <Path Width="14" Height="14" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Fill="{Binding $parent[Button].Foreground}"
                            Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding ErrorMessage}"
                             IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                             FontSize="11"
                             Margin="0,2" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{ReflectionBinding [LaunchSettings_AddEnvVar], Source={StaticResource Loc}}"
                  Command="{Binding AddEnvVarCommand}"
                  HorizontalAlignment="Left"
                  Margin="0,2"
                  MinHeight="32" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Game arguments section -->
    <StackPanel Spacing="6">
      <TextBlock Text="{ReflectionBinding [LaunchSettings_GameArgsHeader], Source={StaticResource Loc}}"
                 FontWeight="SemiBold" />
      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="4">
        <StackPanel Spacing="2" Margin="6">
          <ItemsControl ItemsSource="{Binding GameArguments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameArgRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBox Grid.Column="0"
                           Text="{Binding Value, Mode=TwoWay}"
                           PlaceholderText="{ReflectionBinding [LaunchSettings_GameArgPlaceholder], Source={StaticResource Loc}}" />
                  <Button Grid.Column="1"
                          ToolTip.Tip="{ReflectionBinding [LaunchSettings_RemoveTooltip], Source={StaticResource Loc}}"
                          Click="RemoveArg_Click"
                          CommandParameter="{Binding}"
                          MinWidth="36" Margin="6,0,0,0"
                          VerticalAlignment="Center">
                    <!-- Material "close" cross: drawn geometry, inherits foreground. -->
                    <Path Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding $parent[Button].Foreground}"
                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{ReflectionBinding [LaunchSettings_AddGameArg], Source={StaticResource Loc}}"
                  Command="{Binding AddGameArgCommand}"
                  HorizontalAlignment="Left"
                  Margin="0,2"
                  MinHeight="32" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Game startup section -->
    <StackPanel Spacing="6">
      <TextBlock Text="{ReflectionBinding [LaunchSettings_StartupHeader], Source={StaticResource Loc}}"
                 FontWeight="SemiBold" />
      <CheckBox IsChecked="{Binding SkipSplash, Mode=TwoWay}"
                Content="{ReflectionBinding [LaunchSettings_SkipSplash], Source={StaticResource Loc}}"
                ToolTip.Tip="{ReflectionBinding [LaunchSettings_SkipSplashTooltip], Source={StaticResource Loc}}"
                Margin="0,4" />
    </StackPanel>

    <!-- Logging section -->
    <StackPanel Spacing="6">
      <TextBlock Text="{ReflectionBinding [LaunchSettings_LoggingHeader], Source={StaticResource Loc}}"
                 FontWeight="SemiBold" />
      <CheckBox IsChecked="{Binding EnableLuaLogs, Mode=TwoWay}"
                Content="{ReflectionBinding [LaunchSettings_EnableLuaLogs], Source={StaticResource Loc}}"
                ToolTip.Tip="{ReflectionBinding [LaunchSettings_EnableLuaLogsTooltip], Source={StaticResource Loc}}"
                Margin="0,4" />
    </StackPanel>

    <!-- Static next-launch hint. -->
    <TextBlock Text="{ReflectionBinding [LaunchSettings_NextLaunchHint], Source={StaticResource Loc}}"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               FontSize="11" />

  </StackPanel>
</UserControl>
