<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modificus.Curator.UI.ViewModels"
             xmlns:views="using:Modificus.Curator.UI.Views"
             xmlns:config="using:Modificus.Curator.Config"
             x:Class="Modificus.Curator.UI.Views.ModListView"
             x:DataType="vm:ModListViewModel">

  <UserControl.Styles>
    <!-- Source badge: a subtle pill so it reads as metadata, not body text.
         Applies to the HyperlinkButton variant too (the badge is a link). -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The source badge as a clickable link: pill styling carries over from
         Border.badge, plus a transparent background + a pointer-cursor so the
         badge reads as a link when its SourceUrl is set. The HyperlinkButton's
         default theme is a hyperlink (underline, accent color); this override
         restores the pill look. -->
    <Style Selector="HyperlinkButton.badge">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!--
      Compact icon buttons (up / down / trash / update / order-lock): flat,
      inherit foreground.
    -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--
      Order-lock toggle button. The locked state is unmistakable through BOTH
      shape (closed vs. open padlock) and color: a locked button carries a
      low-emphasis caution-yellow selected fill (CuratorCautionBackgroundBrush)
      and a caution-yellow closed-padlock foreground (CuratorCautionBrush);
      pointer-over preserves the clearly-locked yellow fill rather than replacing
      it with the generic list hover. An unlocked button stays transparent at
      rest with a neutral open-padlock + the generic list hover.
    -->
    <Style Selector="Button.orderLock /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.orderLock:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
    </Style>
    <Style Selector="Button.orderLock.selected">
      <Setter Property="Foreground" Value="{DynamicResource CuratorCautionBrush}" />
    </Style>
    <Style Selector="Button.orderLock.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CuratorCautionBackgroundBrush}" />
    </Style>
    <!--
      Locked + pointer-over keeps the caution-yellow fill (selected fill is
      re-asserted here after the unlocked :pointerover rule) so the row never
      loses its clearly-locked treatment while hovered.
    -->
    <Style Selector="Button.orderLock.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CuratorCautionBackgroundBrush}" />
    </Style>
    <!--
      Drag-reorder grip. A 32-DIP transparent, hit-testable surface at the left
      edge of every row; it is the ONLY surface that initiates row reordering.
      Its IsHitTestVisible is bound to the row's IsGripEnabled (false when the row
      is order-locked), so a locked grip stops intercepting pointer input and its
      area falls through to normal touch scrolling. The drawn Material drag-handle
      path stays visible in both states.
    -->
    <Style Selector="Border.reorderGrip">
      <Setter Property="Width" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!--
      Lifted drag row. Once the reorder threshold is crossed the realized
      ItemsControl container (a ContentPresenter) is lifted: a render transform
      (set in code-behind) moves the full-width row to follow the pointer while
      its layout slot stays reserved (rows do not jump), ZIndex raises it above
      siblings, and this class adds an opaque surface + rounded corners + a
      subtle elevation shadow. Background/CornerRadius/BoxShadow are render-only
      (BorderThickness is avoided: it is AffectsMeasure and would shift sibling
      rows). The class is added/removed by the code-behind; the per-move
      transform + ZIndex are restored from a snapshot on every finish/cancel path.
    -->
    <Style Selector="ContentPresenter.liftedRow">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="0 6 16 -4 #80000000" />
    </Style>
    <!--
      The stable Nexus Latest update-action button carries the "updateAction"
      class IN ADDITION to "icon" so a disabled style can be scoped to it alone.
      The button stays visible when no update is available (it is logically
      disabled via UpdateActionEnabled); without this override the inherited
      disabled foreground reads too close to the enabled icon buttons in Fluent.
      The :disabled pseudo-class dims the whole button to 0.4 opacity, so the
      no-update state is unmistakably subdued/grey. Scoped to updateAction only:
      the move/remove icon buttons (which never take this class) are unaffected,
      and the accent-blue ENABLED state is untouched (:disabled is inactive then).
    -->
    <Style Selector="Button.updateAction:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!--
      Density (Compact/Detailed) toolbar buttons. They reuse the compact
      Button.icon shape (small + flat) plus a `density` class whose selected
      state is bound in XAML to DetailedRows.IsCompact / IsDetailed (the shell's
      conditional-class pattern, not a ToggleButton). The selected background
      uses the same Fluent dynamic resource the navItem tiles use so the active
      density reads consistently across the app; pointerover uses the same
      medium-fill resource so hover is distinct on both selected + unselected
      buttons. Defined after `selected` so :pointerover takes precedence when
      hovering a selected button (a more prominent fill, matching navItem).
    -->
    <Style Selector="Button.density /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.density.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
    <Style Selector="Button.density:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
    </Style>
    <!--
      Detailed row card: a rounded low-emphasis Border using Fluent dynamic
      resources. Border + faint background read as a contained card without
      competing with the thumbnail or text. The Detailed root's IsVisible flag
      selects it; this style only carries the chrome.
    -->
    <Style Selector="Border.detailedRow">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>
    <!--
      Detailed card responsive thumbnail + action layout. Each repeated card
      root (Border.detailedRow) carries Container.Name + Container.Sizing=Width
      so it measures its own width; repeated cards share the name. The card Grid
      has three columns (grip, thumbnail, content); these default (wide) styles
      set the large-card state: a 112-DIP thumbnail spanning all three content
      rows in the thumbnail column, and the right-column action strip in the
      content column. Width, height, row span, action column, and action column
      span are set HERE (not as local values on the elements) so the
      ContainerQuery below can override them; local values outrank styles and
      would defeat the query.
    -->
    <Style Selector="Border.detailedThumb">
      <Setter Property="Width" Value="112" />
      <Setter Property="Height" Value="112" />
      <Setter Property="Grid.RowSpan" Value="3" />
    </Style>
    <Style Selector="Path.detailedPlaceholder">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="WrapPanel.detailedActions">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <!--
      Constrained state (card width at or below 680 DIP): the thumbnail shrinks
      to 72 DIP and spans only name + summary; the single action strip moves to
      a full-width row beneath all three columns. The query targets descendants
      of the named card root, never the queried Border itself, so the card chrome
      is untouched. Declared after the wide defaults so its setters win while the
      query is active.
    -->
    <ContainerQuery Name="detailedModRow" Query="max-width:680">
      <Style Selector="Border.detailedThumb">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Grid.RowSpan" Value="2" />
      </Style>
      <Style Selector="Path.detailedPlaceholder">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
      </Style>
      <Style Selector="WrapPanel.detailedActions">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <!--
    The active profile's mod list: header (title + rate-limit notice +
    check-now refresh + auto-sort + Add split button) over a scrollable row
    list. The no-profile handoff (a HyperlinkButton to Profiles) is owned by
    the shell in MainWindow.axaml and overlays this page only when there is no
    active profile; this view never paints its own no-profile text. The whole
    content area is a drag-and-drop target (folders + archives), so mods can be
    added by dropping as well as via the Add split button's archive + folder
    pickers. The folder picker covers users who prefer a picker over
    drag-and-drop; the drag-and-drop hint surfaces in the no-mods empty state
    + the content-area tooltip. Row interactions route through code-behind
    handlers to the parent VM's commands (the established ManageProfilesWindow
    pattern), passing the row as CommandParameter.

    The row list lives inside a borderless edge-spanning ScrollViewer (the
    scrollbar sits at the destination's right edge): the page-level Grid carries
    only vertical margins so the toolbar + the row content keep their safe left
    + right insets without moving the scrollbar off the edge. Horizontal
    scrolling is disabled (rows wrap their content rather than extending the
    page).

    Icons + markers are drawn <Path> geometry (Material 24x24 source) and
    Ellipse, never Unicode glyphs, per AGENTS.md. The SplitButton's arrow is
    built-in theme chrome, not an authored glyph.
  -->

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Header: check-now refresh + rate-limit notice + hidden auto-sort seam +
         Compact/Detailed density selector + Add split button (hidden until a
         profile is active). The destination title lives in the global shell
         header; this toolbar shows only the Mods-specific actions. Refresh is
         first; the rate-limit notice follows it and occupies the single flexible
         (*) column so the pill keeps its content width at wide widths while the
         column still gives it a finite constraint for ellipsis at narrow widths
         (its full text stays in the tooltip), never pushing the density pair or
         Add out; the hidden auto-sort seam stays wired; the
         density pair sits adjacent immediately before Add. The toolbar carries
         the page's safe left + right insets (the row ScrollViewer below spans to
         the destination edge so its scrollbar sits at the edge, not inset). -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
          IsVisible="{Binding HasActiveProfile}"
          Margin="20,12,20,8">
      <!--
        Rate-limit notice. Occupies the toolbar's flexible (*) column: the pill
        keeps its content width at normal/wide widths (HorizontalAlignment=Left),
        while the star column still gives the Border a finite measure constraint
        so its inner Grid (Auto dot, * text) can ellipsize the notice text at
        narrow widths rather than pushing the density pair or Add out of the
        toolbar. The full RateLimitedNoticeText stays available in the tooltip.
        Collapses entirely when no rate limit is active; the * column then reads
        as the normal gap between refresh and the right-side actions (the same
        gap the old empty spacer column provided).
      -->
      <Border Grid.Column="1"
              Classes="rateLimitedNotice"
              IsVisible="{Binding IsRateLimitActive}"
              Background="{DynamicResource CuratorCautionBackgroundBrush}"
              CornerRadius="8"
              Padding="6,1"
              Margin="8,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              ToolTip.Tip="{Binding RateLimitedTooltip}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
          <Ellipse Grid.Column="0" Width="6" Height="6"
                   Fill="{DynamicResource CuratorCautionBrush}"
                   VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding RateLimitedNoticeText}"
                     TextTrimming="CharacterEllipsis"
                     FontSize="11" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <!--
        Manual "check for updates now": a refresh-affordance button (drawn
        refresh-arrow Path, no glyph), always visible (independent of the
        periodic-check toggle). Click routes through code-behind to the VM's
        CheckForUpdatesNow command, which fires an immediate THOROUGH check
        (the per-mod pass that also catches mods outside the Month window) +
        drives the IsCheckingNow affordance while it runs. The result lands via
        the existing CheckCompleted subscription. The button stays visible at
        all times; it disables while a thorough check is in flight
        (IsCheckingNow), while the manual sliding-window throttle is active, OR
        while an active rate limit has not yet reset (IsRefreshEnabled covers all
        three), and an indeterminate progress spinner overlays the refresh icon
        for the duration. The tooltip is the VM's ManualRefreshTooltip: the
        normal "check for updates now" string normally, the rate-limit message
        while a rate limit is active (server-driven, takes precedence), or the
        live m:ss countdown ("Rate limiting protection enabled. Manual refresh
        will be available again in {time}.") while the manual throttle is active.
      -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                  VerticalAlignment="Center">
        <Button Classes="icon"
                Click="RefreshUpdates_Click"
                IsEnabled="{Binding IsRefreshEnabled}"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding ManualRefreshTooltip}">
          <!-- Material "refresh" (24x24 source): drawn geometry, themed via the
               button foreground. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
        </Button>
        <!-- Indeterminate progress while the thorough check runs (multiple API
             calls, a few seconds). Sits beside the (visible but disabled)
             refresh button; IsVisible=False collapses it out of layout when no
             check is running so the button stands alone. -->
        <ProgressBar Width="18" Height="18"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsCheckingNow}"
                     VerticalAlignment="Center" />
      </StackPanel>
      <!--
        Auto-sort toggle. Intentionally hidden (IsVisible="False"): the real
        dependency-driven IModOrderResolver lands later. The wiring (the
        AutoSortEnabled binding, the AutoSort_Click handler, the
        IdentityModOrderResolver registration) stays intact so the seam drops in
        without a UI change; only the control is collapsed out of layout.
      -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0"
                   IsVisible="False">
        <CheckBox IsChecked="{Binding AutoSortEnabled, Mode=TwoWay}"
                  Click="AutoSort_Click"
                  ToolTip.Tip="{ReflectionBinding [ModList_AutoSortTooltip], Source={StaticResource Loc}}" />
        <TextBlock Text="{ReflectionBinding [ModList_AutoSort], Source={StaticResource Loc}}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <!--
        Compact / Detailed density selector. Two adjacent drawn-icon buttons
        immediately before Add; the active one carries the `selected` class
        (bound to DetailedRows.IsCompact / IsDetailed, the shell's conditional
        class pattern) so the current density is visibly distinct. Clicking a
        button runs DetailedRows.SetDensityCommand with the ModRowDensity enum
        value as its parameter; the coordinator normalizes, persists, and
        reprocesses rows. A click on the already-active density is a strict
        no-op (the coordinator's value-equal guard), so the buttons stay
        enabled. The compact-icon shape comes from the `icon` class; the
        `density` class carries the selected/pointerover background chrome.
        Icons are Material 24x24 source: view_headline (four dense lines) for
        Compact, view_agenda (two stacked blocks) for Detailed, so the two read
        as distinct densities rather than two near-identical lists.
      -->
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                   VerticalAlignment="Center" Margin="16,0,0,0">
        <Button Classes="icon density"
                Classes.selected="{Binding DetailedRows.IsCompact}"
                Command="{Binding DetailedRows.SetDensityCommand}"
                CommandParameter="{x:Static config:ModRowDensity.Compact}"
                ToolTip.Tip="{ReflectionBinding [ModList_CompactRowsTooltip], Source={StaticResource Loc}}"
                AutomationProperties.Name="{ReflectionBinding [ModList_CompactRowsTooltip], Source={StaticResource Loc}}">
          <!-- Material "view_headline" (24x24 source): four dense lines. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M4 15h16v-2H4v2zm0 4h16v-2H4v2zm0-8h16V9H4v2zm0-6v2h16V5H4z" />
        </Button>
        <Button Classes="icon density"
                Classes.selected="{Binding DetailedRows.IsDetailed}"
                Command="{Binding DetailedRows.SetDensityCommand}"
                CommandParameter="{x:Static config:ModRowDensity.Detailed}"
                ToolTip.Tip="{ReflectionBinding [ModList_DetailedRowsTooltip], Source={StaticResource Loc}}"
                AutomationProperties.Name="{ReflectionBinding [ModList_DetailedRowsTooltip], Source={StaticResource Loc}}">
          <!-- Material "view_agenda" (24x24 source): two stacked blocks. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M20 3H3c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h17c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zm0 10H3c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h17c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1z" />
        </Button>
      </StackPanel>
      <!--
        Add split button: primary click runs the current mode's action; the
        arrow opens the flyout. All four flyout items are modes that set
        themselves as the default on click (the face label tracks the mode via
        AddModeLabel): "Add Nexus Mods" (the default; opens the Darktide Nexus
        Mods games page in the browser), "Add Mod (archive)", "Add Mod (folder)"
        (separate because a native picker cannot mix files + folders), and "Link
        external folder". The arrow is built-in theme chrome (no authored glyph).
        Disabled while the inline import workflow is active (editing, processing,
        or failure): the VM's StartBatch gate is the final defense, but the
        disabled button communicates the state visually. Also disabled inside a
        Steam Deck Gaming Mode session (the picker-based add paths are unusable
        there); IsAddEnabled covers both, the tooltip carries the Gaming Mode
        guidance while disabled, and the toolbar hint below explains without
        hover.
      -->
      <SplitButton Grid.Column="4"
                   Click="Add_Click"
                   ToolTip.Tip="{Binding AddButtonTooltip}"
                   ToolTip.ShowOnDisabled="True"
                   IsEnabled="{Binding IsAddEnabled}"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center">
        <SplitButton.Content>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- Material "add" plus (24x24 source): drawn geometry. -->
            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                  Fill="{Binding $parent[SplitButton].Foreground}"
                  Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
            <TextBlock Text="{Binding AddModeLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </SplitButton.Content>
        <SplitButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="{ReflectionBinding [ModList_AddNexusMods], Source={StaticResource Loc}}"
                      Click="AddNexusMods_Click" />
            <MenuItem Header="{ReflectionBinding [ModList_AddArchive], Source={StaticResource Loc}}"
                      Click="AddArchive_Click" />
            <MenuItem Header="{ReflectionBinding [ModList_AddFolder], Source={StaticResource Loc}}"
                      Click="AddFolder_Click" />
            <MenuItem Header="{ReflectionBinding [ModList_LinkExternalFolder], Source={StaticResource Loc}}"
                      Click="LinkFolder_Click" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
      <!--
        Gaming Mode toolbar hint (Steam Deck): shown only while a Gaming Mode
        session is detected, next to the disabled Add split button. The
        touch/controller-reachable explanation for the whole Add affordance (no
        hover required); may ellipsize at narrow widths.
      -->
      <TextBlock Grid.Column="5"
                 Text="{ReflectionBinding [ModList_AddGamingModeHint], Source={StaticResource Loc}}"
                 IsVisible="{Binding IsGamingMode}"
                 FontSize="11"
                 Opacity="0.6"
                 Margin="12,0,0,0"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Grid>

    <!--
      Inline import card (ImportWorkflowView). Visible only while the workflow
      is active (editing, processing, or failure). Hosted directly below the
      toolbar with the same 20px left/right inset. DataContext is the workflow
      child VM (reached through ModListViewModel.ImportWorkflow); the visibility
      binding stays on the wrapper Panel so it resolves against the mod-list VM's
      context, not the workflow VM's.
    -->
    <Panel Grid.Row="1"
           IsVisible="{Binding ImportWorkflow.IsActive}"
           Margin="20,0,20,4">
      <views:ImportWorkflowView DataContext="{Binding ImportWorkflow}" />
    </Panel>

    <!--
      Content area: the drag-and-drop target (AllowDrop/Drop/DragOver stay here
      so drag-and-drop behavior is unchanged). Background="Transparent" is set
      explicitly so the empty area is hit-testable for drops (a Panel/Grid with
      a null Background does not receive drag events on empty space; a
      transparent brush opts in). No behavioral change for populated rows:
      their children handle their own events first.
      Empty states + the row list overlap; visibility selects which shows. The
      no-profile handoff is NOT here: the shell owns it (a HyperlinkButton over
      the Mods panel in MainWindow.axaml) so navigation stays out of this VM.
      The row list is borderless (no rectangle chrome): an edge-spanning
      ScrollViewer (HorizontalScrollBarVisibility=Disabled) so the vertical
      scrollbar sits at the destination's right edge. Rows carry their own
      left + right margins inside the ItemsControl so the action controls have
      a clear right inset without moving the scrollbar off the edge.
    -->
    <Grid Grid.Row="2"
          Background="Transparent"
          DragDrop.AllowDrop="True"
          DragDrop.Drop="OnDrop"
          DragDrop.DragOver="OnDragOver">

      <!--
        Empty: active profile with zero or one mod (typically DMF-only right
        after onboarding). The primary hint invites the user to add their own
        mods alongside the framework. The secondary Nexus line shows ONLY when
        Curator is the registered nxm:// handler, so the user knows the
        'Vortex' / 'Mod manager download' buttons on Nexus route mods straight
        into the app. The no-profile state is owned by the shell.
      -->
      <StackPanel IsVisible="{Binding ShowAddModsHint}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  Margin="20,0">
        <TextBlock Text="{Binding AddModsHintText}"
                   HorizontalAlignment="Center"
                   Opacity="0.6" />
        <TextBlock Text="{Binding NxmDownloadHintText}"
                   IsVisible="{Binding IsNxmRegistered}"
                   FontSize="11"
                   Opacity="0.6"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!-- The mod rows (visible only when there is at least one mod). The
           ScrollViewer spans to the destination edge so its vertical scrollbar
           sits at the edge; horizontal scrolling is disabled (rows wrap their
           content rather than extending the page). The inner ItemsControl
           carries the page's safe left + right insets so the row content +
           the action controls have a clear right inset from the scrollbar.
           No rectangle Border around the populated list: the edge-spanning
           ScrollViewer reads as a clean list, not a boxed region. -->
      <ScrollViewer x:Name="ModListScroll"
                    IsVisible="{Binding HasMods}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0">
        <ItemsControl x:Name="ModListItems" ItemsSource="{Binding Mods}" Margin="20,0">
            <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModItemViewModel">
              <!--
                One row, two mutually exclusive roots selected by the row's
                IsDetailed projection (pushed down by the detailed-rows
                coordinator): the existing Compact Grid + the Detailed card. The
                Compact root is preserved unchanged except for the IsVisible flag
                that now gates it; the Detailed root is a rounded card laid out
                across multiple lines (thumbnail + name/badge/summary on top, a
                wrapping action strip below). Both roots bind the exact same
                per-row state + route to the exact same code-behind handlers, so
                no action behavior forks between modes. The Panel root only hosts
                the two alternatives (it carries no margin of its own); exactly
                one is visible at a time, and each visible root owns its own row
                spacing (the Compact Grid keeps Margin="0,3"; the Detailed Border
                carries its own Margin="0,3").
              -->
              <Panel>
              <!--
                Compact row layout (10 columns): grip | Name | source badge +
                update marker | enabled | policy editor | update button / progress
                | up | down | order-lock | remove. The drag grip is column 0 and is
                the ONLY surface that initiates row reordering; everything else
                stays touch-scrolling surface. The Update button + the indeterminate
                ProgressBar share column 5 (toggled by IsUpdating); they sit between
                the policy editor and the list-management cluster so they group with
                per-mod actions rather than list reordering. The order-lock button
                joins the up/down cluster.
              -->
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    Margin="0,3" MinHeight="32"
                    IsVisible="{Binding !IsDetailed}">

                  <!--
                    Drag-reorder grip (column 0). A transparent, hit-testable
                    surface with a drawn Material drag-handle path; pointer
                    handlers are attached in code-behind. IsHitTestVisible is bound
                    to IsGripEnabled so a locked row's grip stops intercepting
                    pointer input and falls through to touch scrolling (the grip
                    stays visible). Not keyboard-actionable: Move Up / Move Down +
                    the lock button cover keyboard + assistive-tech reordering.
                  -->
                  <Border Grid.Column="0"
                          Classes="reorderGrip"
                          IsHitTestVisible="{Binding IsGripEnabled}"
                          PointerPressed="Grip_PointerPressed"
                          PointerMoved="Grip_PointerMoved"
                          PointerReleased="Grip_PointerReleased"
                          PointerCaptureLost="Grip_PointerCaptureLost"
                          ToolTip.Tip="{ReflectionBinding [ModRow_DragGripTooltip], Source={StaticResource Loc}}"
                          AutomationProperties.Name="{ReflectionBinding [ModRow_DragGripTooltip], Source={StaticResource Loc}}">
                    <!-- Material "drag_indicator" (24x24 source): six dots. -->
                    <Path Width="18" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                          Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                  </Border>

                  <!-- Name -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />

                  <!--
                    Source badge area. The indeterminate progress affordance (shown
                    only while this row's IsUpdating is true) sits immediately LEFT
                    of the source-badge element, occupying the former update-status
                    area, so the row's update activity is visible without replacing
                    the stable update-action button in column 4.

                    The badge cell holds three mutually-exclusive elements driven by
                    row-VM flags (only one is visible per row):
                      - Nexus/Untracked badge (HyperlinkButton, NavigateUri=SourceUrl):
                        visible when the row is not linked. For Nexus the click opens
                        the mod page; for Untracked the NavigateUri is null (no-op).
                      - Linked + available badge (HyperlinkButton, Click=OpenFolder_Click):
                        visible when the row is linked and its external folder is present.
                        Click opens the OS file manager at the external folder (the
                        HyperlinkButton leaves NavigateUri unset and uses the Click
                        member directly, per the Avalonia 12 supported pattern for
                        non-URI navigation).
                      - Linked + broken text (Border + TextBlock, non-clickable):
                        visible when the row is linked and its external folder is
                        missing. Warning foreground (the same caution brush the
                        rate-limit notice uses) so the state is unmistakable.
                  -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                              Margin="8,0,0,0" VerticalAlignment="Center">
                    <!-- Indeterminate progress while a per-row update install
                         runs. Visible only for the row whose IsUpdating is true.
                         Placed left of the badge (where the old update-available
                         marker used to begin). -->
                    <ProgressBar Width="18" Height="18"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsUpdating}"
                                 VerticalAlignment="Center" />
                    <!-- Nexus / Untracked badge (hidden for linked rows). -->
                    <HyperlinkButton Classes="badge"
                                     NavigateUri="{Binding SourceUrl}"
                                     IsVisible="{Binding IsBadgeHyperlink}"
                                     ToolTip.Tip="{ReflectionBinding [ModRow_SourceBadgeLinkTooltip], Source={StaticResource Loc}}">
                      <TextBlock Text="{Binding SourceBadgeText}" FontSize="11" />
                    </HyperlinkButton>
                    <!-- Linked + available: clickable pill opening the external
                         folder in the OS file manager. NavigateUri is
                         intentionally unset; the Click handler routes to the
                         parent's OpenFolderCommand. Disabled inside a Steam
                         Deck Gaming Mode session (file-manager opens depend on
                         a desktop shell); the tooltip swaps to the Gaming Mode
                         guidance there. -->
                    <HyperlinkButton Classes="badge"
                                     IsVisible="{Binding IsLinkedAvailable}"
                                     Click="OpenFolder_Click"
                                     IsEnabled="{Binding !IsGamingMode}"
                                     ToolTip.Tip="{Binding LinkedBadgeTooltip}"
                                     ToolTip.ShowOnDisabled="True">
                      <TextBlock Text="{Binding SourceBadgeText}" FontSize="11" />
                    </HyperlinkButton>
                    <!-- Linked + broken: non-clickable warning text in a pill,
                         so the broken state reads as the same shape but clearly
                         subdued. The caution brush is the established warning
                         foreground (the rate-limit notice dot uses it too). -->
                    <Border Classes="badge"
                            IsVisible="{Binding IsLinkedBroken}"
                            ToolTip.Tip="{ReflectionBinding [ModRow_LinkedBrokenTooltip], Source={StaticResource Loc}}">
                      <TextBlock Text="{Binding SourceBadgeText}" FontSize="11"
                                 Foreground="{DynamicResource CuratorCautionBrush}" />
                    </Border>
                  </StackPanel>

                  <!-- Enabled toggle (two-way; Click applies via the parent). -->
                  <CheckBox Grid.Column="3"
                            IsChecked="{Binding Enabled, Mode=TwoWay}"
                            Click="Enabled_Click"
                            ToolTip.Tip="{ReflectionBinding [ModRow_EnabledTooltip], Source={StaticResource Loc}}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center" />

                  <!-- Policy editor: ComboBox (Latest/Pinned) + inline version dropdown. -->
                  <!--
                    The pin is a constrained dropdown of the container's versions
                    (bound to the row's AvailableVersions): the user can only pin to
                    a version that exists in the container. The dropdown shows the
                    readable version tag and stores the opaque folder id, which the
                    parent's SetPolicyPinned command wraps as PinnedPolicy(versionId).
                    (The import-modal version field stays free-text: it declares the
                    version of files being imported, which is how a new version row
                    enters the container in the first place.)
                  -->
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                              Margin="12,0,0,0" VerticalAlignment="Center">
                    <ComboBox SelectedIndex="{Binding PolicyChoice, Mode=TwoWay}"
                              SelectionChanged="Policy_Changed"
                              IsEnabled="{Binding IsPolicyEditable}"
                              MinWidth="100">
                      <ComboBoxItem Content="{ReflectionBinding [ModRow_PolicyLatest], Source={StaticResource Loc}}" />
                      <ComboBoxItem Content="{ReflectionBinding [ModRow_PolicyPinned], Source={StaticResource Loc}}" />
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding AvailableVersions}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                              SelectionChanged="PinnedVersion_Changed"
                              IsVisible="{Binding IsPinned}"
                              PlaceholderText="{ReflectionBinding [ModRow_PinnedVersionPlaceholder], Source={StaticResource Loc}}"
                              MinWidth="120">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VersionOption">
                          <TextBlock Text="{Binding VersionString}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <!--
                    The stable update-action cell. A fixed-width Panel reserves
                    space on EVERY row (so later controls never shift when the
                    button appears/disappears). For Nexus + Latest rows it holds
                    the update button; for Pinned Nexus and Untracked
                    rows the cell stays reserved but empty. The button stays
                    visible even while a row is updating (it is disabled via
                    UpdateActionEnabled); the indeterminate progress affordance
                    moved to the source-badge area (column 1) so the action cell
                    does not shift during start/end of an update.

                    The button shows for Nexus + Latest rows regardless of
                    account tier + regardless of whether an update is available.
                    No update -> disabled, neutral/grey download arrow (inherits
                    the disabled foreground + the updateAction :disabled style
                    dims the whole button to 0.4 opacity so it is unmistakably
                    subdued). Update available -> enabled, with the drawn
                    download-arrow Path in accent blue. No animation/flashing, no
                    Unicode icons. Premium click runs the existing in-app update;
                    regular/unknown click opens the mod's Nexus files page (the
                    row VM carries the click behavior; the tooltip distinguishes
                    the cases).
                  -->
                  <Panel Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center"
                         MinWidth="28">
                    <Button Classes="icon updateAction"
                            Click="Update_Click"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding CanShowUpdateAction}"
                            IsEnabled="{Binding UpdateActionEnabled}"
                            ToolTip.Tip="{Binding UpdateActionTooltip}">
                      <Panel>
                        <!-- Neutral/grey download arrow (no update / disabled):
                             inherits the button foreground; the updateAction
                             :disabled style further dims the whole button to
                             0.4 opacity so the no-update state is unmistakably
                             subdued. -->
                        <Path Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding !UpdateAvailable}"
                              Fill="{Binding $parent[Button].Foreground}"
                              Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                        <!-- Accent-blue download arrow (update available). -->
                        <Path Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding UpdateAvailable}"
                              Fill="{DynamicResource SystemControlForegroundAccentBrush}"
                              Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                      </Panel>
                    </Button>
                  </Panel>

                  <!--
                    Move up (drawn up-chevron). Enabled only for an unlocked row
                    with an unlocked row above it (CanMoveUp, computed by the
                    parent); disabled otherwise, including locked rows.
                  -->
                  <Button Grid.Column="6" Classes="icon"
                          IsEnabled="{Binding CanMoveUp}"
                          ToolTip.Tip="{ReflectionBinding [ModRow_MoveUpTooltip], Source={StaticResource Loc}}"
                          Click="MoveUp_Click"
                          CommandParameter="{Binding}"
                          Margin="8,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding $parent[Button].Foreground}"
                          Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                  </Button>

                  <!-- Move down (drawn down-chevron). -->
                  <Button Grid.Column="7" Classes="icon"
                          IsEnabled="{Binding CanMoveDown}"
                          ToolTip.Tip="{ReflectionBinding [ModRow_MoveDownTooltip], Source={StaticResource Loc}}"
                          Click="MoveDown_Click"
                          CommandParameter="{Binding}"
                          Margin="4,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding $parent[Button].Foreground}"
                          Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                  </Button>

                  <!--
                    Order-lock toggle (drawn padlock). The locked state reads
                    through BOTH shape (closed vs. open padlock) and color: the
                    `selected` class (bound to OrderLocked) swaps the button
                    foreground to caution-yellow + a caution-yellow fill, and the
                    closed-padlock path is shown. The unlocked state shows a
                    neutral open-padlock with a deliberately large, obvious
                    shackle opening. Both paths render at 18 DIP. The tooltip +
                    automation text are dynamic (lock / unlock).
                  -->
                  <Button Grid.Column="8" Classes="icon orderLock"
                          Classes.selected="{Binding OrderLocked}"
                          Click="ToggleOrderLock_Click"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding OrderLockTooltip}"
                          AutomationProperties.Name="{Binding OrderLockAutomationName}"
                          Margin="4,0,0,0">
                    <Panel>
                      <!-- Closed padlock (locked): shown when locked. Inherits the
                           caution-yellow foreground from the selected style. -->
                      <Path Width="18" Height="18" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding OrderLocked}"
                            Fill="{Binding $parent[Button].Foreground}"
                            Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                      <!--
                        Open padlock (unlocked): the closed icon's exact body,
                        corners, keyhole, and shackle arch, with only the shackle
                        differing: the left leg ends above the body, leaving a
                        clear side gap (the right leg stays attached).
                      -->
                      <Path Width="18" Height="18" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding !OrderLocked}"
                            Fill="{Binding $parent[Button].Foreground}"
                            Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 5h1.9c0-1.16 1.39-2.1 3.1-2.1 1.71 0 3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
                    </Panel>
                  </Button>

                  <!-- Remove (drawn trash). -->
                  <Button Grid.Column="9" Classes="icon"
                          ToolTip.Tip="{ReflectionBinding [ModRow_RemoveTooltip], Source={StaticResource Loc}}"
                          Click="Remove_Click"
                          CommandParameter="{Binding}"
                          Margin="4,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding $parent[Button].Foreground}"
                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                  </Button>

                  <!--
                    Drag insertion markers (2-DIP accent line, non-hit-testable).
                    At most one is visible on at most one row while dragging: before
                    the target row for an upward move, after it for a downward move.
                    Spans every column so the line reads across the whole row.
                  -->
                  <Border Grid.ColumnSpan="10"
                          VerticalAlignment="Top" Height="2"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ShowReorderMarkerBefore}"
                          Background="{DynamicResource SystemControlForegroundAccentBrush}" />
                  <Border Grid.ColumnSpan="10"
                          VerticalAlignment="Bottom" Height="2"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ShowReorderMarkerAfter}"
                          Background="{DynamicResource SystemControlForegroundAccentBrush}" />

                </Grid>

                <!--
                  DETAILED row root. A rounded low-emphasis card (Border via the
                  detailedRow style) laid out as one adaptive Grid: column 0 is
                  the drag grip, column 1 is the thumbnail/placeholder slot,
                  column 2 holds the name + source badge (row 0) and the two-line
                  summary (row 1), and row 2 is the WrapPanel action strip. The
                  card root is a named width container (Container.Name +
                  Container.Sizing=Width) so a ContainerQuery in UserControl.Styles
                  swaps the thumbnail size + row span and moves the action strip
                  full-width at the 680-DIP breakpoint. Width, height, row-span,
                  and action-column values that change at the breakpoint come from
                  those styles (not local values, which would outrank styles);
                  constant row/column positions stay local. The same action
                  controls + code-behind handlers as the Compact root are reused,
                  so no action behavior forks between modes. Markup is deliberately
                  duplicated from the Compact root (no new template abstraction).
                  No horizontal ScrollViewer; only the page-level vertical
                  ScrollViewer scrolls.
                -->
                <Border IsVisible="{Binding IsDetailed}"
                        Classes="detailedRow"
                        Container.Name="detailedModRow"
                        Container.Sizing="Width"
                        Margin="0,3"
                        Padding="12">
                  <Panel>
                  <Grid ColumnDefinitions="Auto,Auto,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="6">
                      <!--
                        Drag-reorder grip (column 0, spans all rows). Same surface
                        + contract as the Compact grip: the only row area that
                        initiates reordering; IsHitTestVisible bound to IsGripEnabled
                        so a locked row falls through to touch scrolling. The grip
                        stays at the card's left edge across both wide + constrained
                        layouts.
                      -->
                      <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                              Classes="reorderGrip"
                              IsHitTestVisible="{Binding IsGripEnabled}"
                              PointerPressed="Grip_PointerPressed"
                              PointerMoved="Grip_PointerMoved"
                              PointerReleased="Grip_PointerReleased"
                              PointerCaptureLost="Grip_PointerCaptureLost"
                              ToolTip.Tip="{ReflectionBinding [ModRow_DragGripTooltip], Source={StaticResource Loc}}"
                              AutomationProperties.Name="{ReflectionBinding [ModRow_DragGripTooltip], Source={StaticResource Loc}}">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                      </Border>

                      <!--
                        Thumbnail area (column 1). A rounded, clipped square
                        whose Width, Height, and Grid.RowSpan come from the
                        Border.detailedThumb styles (112 DIP spanning all three
                        rows when wide; 72 DIP spanning name + summary when
                        constrained). Border implements
                        IVisualWithRoundRectClip with ClipToBoundsRadius mapped
                        to CornerRadius, so ClipToBounds clips the child to the
                        rounded boundary. The Image shows only when a thumbnail
                        has been decoded; every no-image case (Untracked/Linked,
                        missing metadata, no auth, offline, failed image, adult
                        flag, empty URL) shows the same neutral drawn-geometry
                        placeholder in the same box. Adult rows never receive a
                        thumbnail (the coordinator skips them), so they fall
                        through to the placeholder here.
                      -->
                      <Border Grid.Row="0" Grid.Column="1"
                              Classes="detailedThumb"
                              CornerRadius="8" ClipToBounds="True"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}">
                        <Panel>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                 IsVisible="{Binding HasThumbnail}" />
                          <!--
                            Neutral placeholder (Material "image", 24x24 source):
                            low-opacity themed foreground so it reads as an empty
                            image slot, not body text. Drawn geometry, not a
                            glyph. Width/Height come from the
                            Path.detailedPlaceholder styles (36 DIP wide; 28 DIP
                            constrained).
                          -->
                          <Path Classes="detailedPlaceholder"
                                Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !HasThumbnail}"
                                Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Opacity="0.6"
                                Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                        </Panel>
                      </Border>

                      <!--
                        Name + source badge (row 0, column 2). A constrained Grid
                        (star name, auto badge) rather than a horizontal
                        StackPanel: the star column bounds the name so it
                        ellipsizes on long names (the full text stays in the
                        tooltip + the automation name), and the badge cluster
                        keeps its natural width. Reproduces the Compact root's
                        three mutually-exclusive badge states + the indeterminate
                        update progress, with the same bindings +
                        OpenFolder_Click handler.
                      -->
                      <Grid Grid.Row="0" Grid.Column="2"
                            ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Name}"
                                     AutomationProperties.Name="{Binding Name}"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                      VerticalAlignment="Center">
                            <!-- Indeterminate progress while a per-row update
                                 install runs (same binding as Compact). -->
                            <ProgressBar Width="18" Height="18"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsUpdating}"
                                         VerticalAlignment="Center" />
                            <!-- Nexus / Untracked badge (hidden for linked rows). -->
                            <HyperlinkButton Classes="badge"
                                             NavigateUri="{Binding SourceUrl}"
                                             IsVisible="{Binding IsBadgeHyperlink}"
                                             ToolTip.Tip="{ReflectionBinding [ModRow_SourceBadgeLinkTooltip], Source={StaticResource Loc}}">
                              <TextBlock Text="{Binding SourceBadgeText}" FontSize="11" />
                            </HyperlinkButton>
                            <!-- Linked + available: opens the external folder.
                                 Same Gaming Mode gating + tooltip swap as the
                                 Compact root's badge. -->
                            <HyperlinkButton Classes="badge"
                                             IsVisible="{Binding IsLinkedAvailable}"
                                             Click="OpenFolder_Click"
                                             IsEnabled="{Binding !IsGamingMode}"
                                             ToolTip.Tip="{Binding LinkedBadgeTooltip}"
                                             ToolTip.ShowOnDisabled="True">
                              <TextBlock Text="{Binding SourceBadgeText}" FontSize="11" />
                            </HyperlinkButton>
                            <!-- Linked + broken: non-clickable warning text. -->
                            <Border Classes="badge"
                                    IsVisible="{Binding IsLinkedBroken}"
                                    ToolTip.Tip="{ReflectionBinding [ModRow_LinkedBrokenTooltip], Source={StaticResource Loc}}">
                              <TextBlock Text="{Binding SourceBadgeText}" FontSize="11"
                                         Foreground="{DynamicResource CuratorCautionBrush}" />
                            </Border>
                          </StackPanel>
                        </Grid>

                      <!--
                        Summary (row 1, column 2): at most two wrapped lines,
                        safely trimmed. The full text is preserved in the
                        tooltip (when non-null) + the automation name (always,
                        so the fallback text stays reachable by assistive tech
                        even when visually clipped).
                      -->
                      <TextBlock Grid.Row="1" Grid.Column="2"
                                 Text="{Binding SummaryText}"
                                 MaxLines="2" TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding SummaryTooltip}"
                                 AutomationProperties.Name="{Binding SummaryText}" />

                      <!--
                        Action strip (row 2). A WrapPanel so the controls wrap at
                        the containing edge at narrow widths (no clip, no horizontal
                        scrolling). ItemsAlignment=End right-aligns every wrapped
                        line in both states. Grid.Column + Grid.ColumnSpan come from
                        the WrapPanel.detailedActions styles (right column only when
                        wide; full width across both columns when constrained), so
                        the container query moves the strip without duplicating it.
                        The exact same event handlers / two-way bindings / command
                        parameters as the Compact root's action cells, grouped so
                        the strip reads cleanly: Enabled (label as the checkbox
                        content), policy controls kept together as one wrap unit,
                        the stable update-action reserved cell, then the move/remove
                        cluster.
                      -->
                      <WrapPanel Grid.Row="2"
                                 Classes="detailedActions"
                                 Orientation="Horizontal"
                                 ItemSpacing="8" LineSpacing="6"
                                 ItemsAlignment="End">
                      <!--
                        Enabled. The localized label is the CheckBox content so
                        the whole label is part of the click hit target (not an
                        unrelated sibling), with an explicit automation name. The
                        Click handler + the two-way Enabled binding match the
                        Compact checkbox exactly.
                      -->
                      <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                Click="Enabled_Click"
                                Content="{ReflectionBinding [ModRow_Enabled], Source={StaticResource Loc}}"
                                ToolTip.Tip="{ReflectionBinding [ModRow_EnabledTooltip], Source={StaticResource Loc}}"
                                AutomationProperties.Name="{ReflectionBinding [ModRow_Enabled], Source={StaticResource Loc}}"
                                VerticalAlignment="Center" />

                      <!--
                        Policy editor: Latest/Pinned ComboBox + inline version
                        dropdown, grouped as a single wrap unit so they stay on
                        one line when they fit and wrap together when they do
                        not. Same bindings + handlers as Compact.
                      -->
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Center">
                        <ComboBox SelectedIndex="{Binding PolicyChoice, Mode=TwoWay}"
                                  SelectionChanged="Policy_Changed"
                                  IsEnabled="{Binding IsPolicyEditable}"
                                  MinWidth="100">
                          <ComboBoxItem Content="{ReflectionBinding [ModRow_PolicyLatest], Source={StaticResource Loc}}" />
                          <ComboBoxItem Content="{ReflectionBinding [ModRow_PolicyPinned], Source={StaticResource Loc}}" />
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding AvailableVersions}"
                                  SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                  SelectionChanged="PinnedVersion_Changed"
                                  IsVisible="{Binding IsPinned}"
                                  PlaceholderText="{ReflectionBinding [ModRow_PinnedVersionPlaceholder], Source={StaticResource Loc}}"
                                  MinWidth="120">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionOption">
                              <TextBlock Text="{Binding VersionString}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>

                      <!--
                        Stable update-action cell: reserved fixed width on every
                        row, the SAME button state as Compact. For Nexus + Latest
                        rows it holds the drawn download-arrow button (disabled
                        + neutral when no update, accent-blue when flagged);
                        other rows keep the reserved cell but no button.
                      -->
                      <Panel MinWidth="28" VerticalAlignment="Center">
                        <Button Classes="icon updateAction"
                                Click="Update_Click"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding CanShowUpdateAction}"
                                IsEnabled="{Binding UpdateActionEnabled}"
                                ToolTip.Tip="{Binding UpdateActionTooltip}">
                          <Panel>
                            <!-- Neutral/grey download arrow (no update / disabled). -->
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding !UpdateAvailable}"
                                  Fill="{Binding $parent[Button].Foreground}"
                                  Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                            <!-- Accent-blue download arrow (update available). -->
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding UpdateAvailable}"
                                  Fill="{DynamicResource SystemControlForegroundAccentBrush}"
                                  Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                          </Panel>
                        </Button>
                      </Panel>

                      <!--
                        Move up / down / order-lock / remove: same handlers,
                        tooltips, and IsEnabled bindings as the Compact root's
                        action cluster. The lock button joins the up/down cluster
                        (selected class bound to OrderLocked).
                      -->
                      <Button Classes="icon"
                              IsEnabled="{Binding CanMoveUp}"
                              ToolTip.Tip="{ReflectionBinding [ModRow_MoveUpTooltip], Source={StaticResource Loc}}"
                              Click="MoveUp_Click"
                              CommandParameter="{Binding}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{Binding $parent[Button].Foreground}"
                              Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
                      </Button>
                      <Button Classes="icon"
                              IsEnabled="{Binding CanMoveDown}"
                              ToolTip.Tip="{ReflectionBinding [ModRow_MoveDownTooltip], Source={StaticResource Loc}}"
                              Click="MoveDown_Click"
                              CommandParameter="{Binding}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{Binding $parent[Button].Foreground}"
                              Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
                      </Button>
                      <!--
                        Order-lock toggle (drawn padlock), same shape + color
                        treatment as the Compact root: closed padlock + caution
                        fill/foreground when locked, open padlock (large shackle
                        opening) + neutral when unlocked. Both 18 DIP.
                      -->
                      <Button Classes="icon orderLock"
                              Classes.selected="{Binding OrderLocked}"
                              Click="ToggleOrderLock_Click"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding OrderLockTooltip}"
                              AutomationProperties.Name="{Binding OrderLockAutomationName}">
                        <Panel>
                          <Path Width="18" Height="18" Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding OrderLocked}"
                                Fill="{Binding $parent[Button].Foreground}"
                                Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                          <Path Width="18" Height="18" Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !OrderLocked}"
                                Fill="{Binding $parent[Button].Foreground}"
                                Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 5h1.9c0-1.16 1.39-2.1 3.1-2.1 1.71 0 3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
                        </Panel>
                      </Button>
                      <Button Classes="icon"
                              ToolTip.Tip="{ReflectionBinding [ModRow_RemoveTooltip], Source={StaticResource Loc}}"
                              Click="Remove_Click"
                              CommandParameter="{Binding}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{Binding $parent[Button].Foreground}"
                              Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                      </Button>
                    </WrapPanel>

                  </Grid>
                  <!--
                    Drag insertion markers (2-DIP accent line, non-hit-testable),
                    siblings of the card content so they anchor to the card's
                    inner top/bottom edge. At most one is visible on at most one
                    row while dragging.
                  -->
                  <Border VerticalAlignment="Top" Height="2"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ShowReorderMarkerBefore}"
                          Background="{DynamicResource SystemControlForegroundAccentBrush}" />
                  <Border VerticalAlignment="Bottom" Height="2"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ShowReorderMarkerAfter}"
                          Background="{DynamicResource SystemControlForegroundAccentBrush}" />
                  </Panel>
                </Border>
              </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
  </Grid>
</UserControl>
