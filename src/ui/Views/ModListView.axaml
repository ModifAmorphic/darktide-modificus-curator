<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modificus.Curator.UI.ViewModels"
             xmlns:views="using:Modificus.Curator.UI.Views"
             xmlns:config="using:Modificus.Curator.Config"
             x:Class="Modificus.Curator.UI.Views.ModListView"
             x:DataType="vm:ModListViewModel">

  <!--
    The shared per-row building blocks, ONE definition each, hosted by both the
    Compact + Detailed row roots through ContentControl.ContentTemplate (the
    spec's shared-DataTemplate shape). Event handlers inside these templates
    resolve against THIS file's code-behind (the templates live in the same
    XAML document + namescope), and the page-level Styles + the
    detailedModRow ContainerQuery still apply to the realized instances:
    Avalonia styles select by searching the logical tree upwards from each
    control, so the nested template content matches the same page-level
    selectors.

    Layout parity: the ContentControl host adds no chrome (its theme is a bare
    ContentPresenter), so the wrapped panel receives the same measure
    constraint + contributes the same desired size the direct child did. The
    per-density differences (the Compact strip's tighter inter-control margins
    + the Detailed-only Enabled label) are preserved per root: margins come
    from the Grid.compactRow-scoped styles below, and the label comes from the
    row's density-aware EnabledLabel (null in Compact, so the compact row's
    checkbox carries no label).
  -->
  <UserControl.Resources>

    <!--
      The drag-reorder grip. A transparent, hit-testable surface with a drawn
      Material drag-handle path; pointer handlers are attached in code-behind
      (the sender is the Border itself, whichever root hosts it). Not keyboard
      actionable: Move Up / Move Down + the lock button cover keyboard +
      assistive-tech reordering. Grid row/column placement differs per root and
      is set on the hosting ContentControl.
    -->
    <DataTemplate x:Key="ModRowGripTemplate" x:DataType="vm:ModItemViewModel">
      <Border Classes="reorderGrip"
              IsHitTestVisible="{Binding IsGripEnabled}"
              PointerPressed="Grip_PointerPressed"
              PointerMoved="Grip_PointerMoved"
              PointerReleased="Grip_PointerReleased"
              PointerCaptureLost="Grip_PointerCaptureLost"
              ToolTip.Tip="{ReflectionBinding [ModRow_DragGripTooltip], Source={StaticResource Loc}}"
              AutomationProperties.Name="{ReflectionBinding [ModRow_DragGripTooltip], Source={StaticResource Loc}}">
        <!-- Material "drag_indicator" (24x24 source): six dots. -->
        <Path Width="18" Height="18" Stretch="Uniform"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
      </Border>
    </DataTemplate>

    <!--
      The source-badge area: three mutually-exclusive badge states driven by
      row-VM flags (only one visible per row):
        - Nexus/Untracked badge (HyperlinkButton, NavigateUri=SourceUrl): for
          rows that are not linked. For Nexus the click opens the mod page; for
          Untracked the NavigateUri is null (no-op).
        - Linked + available badge (HyperlinkButton, Click=OpenFolder_Click):
          opens the OS file manager at the external folder (NavigateUri
          intentionally unset; the Click member routes to the command, per the
          Avalonia 12 supported pattern for non-URI navigation). Disabled
          inside a Gaming Mode session; the tooltip swaps to Desktop Mode
          guidance there.
        - Linked + broken text (Border + TextBlock, non-clickable): warning
          foreground (the same caution brush the rate-limit notice uses) so the
          state is unmistakable.
      The hosting root supplies the cell margin where one is needed (Compact).
    -->
    <DataTemplate x:Key="ModRowBadgesTemplate" x:DataType="vm:ModItemViewModel">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <!-- Nexus / Untracked badge (hidden for linked rows). -->
        <HyperlinkButton Classes="badge"
                         NavigateUri="{Binding SourceUrl}"
                         IsVisible="{Binding IsBadgeHyperlink}"
                         ToolTip.Tip="{ReflectionBinding [ModRow_SourceBadgeLinkTooltip], Source={StaticResource Loc}}">
          <TextBlock Text="{Binding SourceBadgeText}" FontSize="11" />
        </HyperlinkButton>
        <!-- Linked + available: clickable pill opening the external folder in
             the OS file manager. -->
        <HyperlinkButton Classes="badge"
                         IsVisible="{Binding IsLinkedAvailable}"
                         Click="OpenFolder_Click"
                         IsEnabled="{Binding !IsGamingMode}"
                         ToolTip.Tip="{Binding LinkedBadgeTooltip}"
                         ToolTip.ShowOnDisabled="True">
          <TextBlock Text="{Binding SourceBadgeText}" FontSize="11" />
        </HyperlinkButton>
        <!-- Linked + broken: non-clickable warning text in the same pill
             shape, clearly subdued. -->
        <Border Classes="badge"
                IsVisible="{Binding IsLinkedBroken}"
                ToolTip.Tip="{ReflectionBinding [ModRow_LinkedBrokenTooltip], Source={StaticResource Loc}}">
          <TextBlock Text="{Binding SourceBadgeText}" FontSize="11"
                     Foreground="{DynamicResource CuratorCautionBrush}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!--
      The action strip: Enabled (label in Detailed via the density-aware
      EnabledLabel), the policy editor (Latest/Pinned ComboBox + the inline
      version dropdown, grouped as one wrap unit), the stable reserved
      update-action cell, then the move/remove cluster (up / down / order-lock
      / remove). One WrapPanel root so the strip wraps at the containing edge
      in Detailed; in Compact the host grid measures the Auto column against
      the full row width, which at the 720-DIP window floor always exceeds the
      strip's largest possible desired width (the policy cluster is bounded by
      its two short localized labels + the MinWidth 100/120 dropdowns), so the
      wrap branch stays unreachable there and the row keeps its single-line
      layout. ItemSpacing/LineSpacing + the Compact margins come from the
      page styles (styles, not local values, so each density can differ).
      The marker classes (updateCell / moveUp / moveDown / remove) exist so
      the compact margin styles can address each control.
    -->
    <DataTemplate x:Key="ModRowActionStripTemplate" x:DataType="vm:ModItemViewModel">
      <WrapPanel Classes="actionStrip"
                 Orientation="Horizontal"
                 ItemsAlignment="End">
        <!--
          Enabled. In Detailed the localized label is the CheckBox content so
          the whole label is part of the click hit target, with an explicit
          automation name; in Compact EnabledLabel is null, the exact
          contentless checkbox the single-line row has always shown. The Click
          handler + the two-way Enabled binding are shared by both densities.
        -->
        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                  Click="Enabled_Click"
                  Content="{Binding EnabledLabel}"
                  AutomationProperties.Name="{Binding EnabledLabel}"
                  ToolTip.Tip="{ReflectionBinding [ModRow_EnabledTooltip], Source={StaticResource Loc}}"
                  VerticalAlignment="Center" />

        <!--
          Policy editor: Latest/Pinned ComboBox + inline version dropdown,
          grouped as a single wrap unit so they stay on one line when they fit
          and wrap together when they do not. The pin is a constrained
          dropdown of the container's versions (bound to AvailableVersions):
          the user can only pin to a version that exists in the container. The
          dropdown shows the readable version tag and stores the opaque folder
          id, which the SetPolicyPinned command wraps as
          PinnedPolicy(versionId). Disabled for linked rows (a linked mod has
          a single implicit version) and while a download morphs the row
          (IsPolicyEditable covers both; the morphing download writes the
          policy itself at completion, so a manual edit would race it). A
          version-unknown row offers no pin: its only version carries an empty
          tag (nothing legible to pin to), so the Pinned choice is disabled
          and the dropdown never renders (CanShowVersionDropdown covers the
          IsPinned + not-unknown conjunction).
        -->
        <StackPanel Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
          <ComboBox SelectedIndex="{Binding PolicyChoice, Mode=TwoWay}"
                    SelectionChanged="Policy_Changed"
                    IsEnabled="{Binding IsPolicyEditable}"
                    MinWidth="100">
            <ComboBoxItem Content="{ReflectionBinding [ModRow_PolicyLatest], Source={StaticResource Loc}}" />
            <ComboBoxItem Content="{ReflectionBinding [ModRow_PolicyPinned], Source={StaticResource Loc}}"
                          IsEnabled="{Binding !IsVersionUnknown}" />
          </ComboBox>
          <ComboBox ItemsSource="{Binding AvailableVersions}"
                    SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                    SelectionChanged="PinnedVersion_Changed"
                    IsVisible="{Binding CanShowVersionDropdown}"
                    IsEnabled="{Binding IsPolicyEditable}"
                    PlaceholderText="{ReflectionBinding [ModRow_PinnedVersionPlaceholder], Source={StaticResource Loc}}"
                    MinWidth="120">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VersionOption">
                <TextBlock Text="{Binding VersionString}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!--
          The stable update-action cell. A fixed-width Panel reserves space on
          EVERY row (so later controls never shift when the button
          appears/disappears). For Nexus + Latest rows it holds the update
          button; for Pinned Nexus and Untracked rows the cell stays reserved
          but empty. No update + not version-unknown -> disabled, neutral/grey
          download arrow (the updateAction:disabled style dims the whole button
          to 0.4 opacity); update available OR version unknown (the resolution
          path) -> enabled with the accent-blue arrow. Premium click enqueues
          the in-app update (for an unknown row, the resolution install with an
          empty expected version); regular/unknown click opens the mod's Nexus
          files page (the row VM carries the click behavior; the tooltip
          distinguishes the cases).
          While a download morphs the row, the WHOLE cell is not rendered
          (the morph's progress owns the row's progress surface, and hiding
          the update button entirely is the double-click guard) and the strip
          instead offers the download's Cancel.
        -->
        <Panel Classes="updateCell" MinWidth="28" VerticalAlignment="Center"
               IsVisible="{Binding !IsDownloadMorphed}">
          <Button Classes="icon updateAction"
                  Click="Update_Click"
                  CommandParameter="{Binding}"
                  IsVisible="{Binding CanShowUpdateAction}"
                  IsEnabled="{Binding UpdateActionEnabled}"
                  ToolTip.Tip="{Binding UpdateActionTooltip}">
            <Panel>
              <!-- Neutral/grey download arrow (no update + not unknown:
                   disabled; inherits the button foreground). -->
              <Path Width="16" Height="16" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding !UpdateActionEnabled}"
                    Fill="{Binding $parent[Button].Foreground}"
                    Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
              <!-- Accent-blue download arrow (update available or version
                   unknown: enabled + accent while unknown too). -->
              <Path Width="16" Height="16" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding UpdateActionEnabled}"
                    Fill="{DynamicResource SystemControlForegroundAccentBrush}"
                    Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
            </Panel>
          </Button>
        </Panel>

        <!--
          The download Cancel: replaces the update-action cell's position in
          the strip while a download morphs the row (the morph swaps the
          strip's action offering to Cancel only; Enabled, policy, and the
          move/lock/remove cluster remain). The command + tooltip bind
          through the row's ActiveDownload wrapper; disabled once the item is
          terminal (a Failed row offers Retry + dismiss in the status area).
        -->
        <Button Classes="icon downloadCancel"
                IsVisible="{Binding IsDownloadMorphed}"
                IsEnabled="{Binding ActiveDownload.CanCancel}"
                Command="{Binding ActiveDownload.CancelCommand}"
                ToolTip.Tip="{Binding ActiveDownload.CancelTooltip}"
                AutomationProperties.Name="{Binding ActiveDownload.CancelTooltip}">
          <!-- Material "cancel" (24x24 source): filled circle with the X
               knocked out, distinct from the dismiss button's bare X. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z" />
        </Button>

        <!--
          Move up (drawn up-chevron). Enabled only for an unlocked row with an
          unlocked row above it (CanMoveUp, computed by the parent); disabled
          otherwise, including locked rows.
        -->
        <Button Classes="icon moveUp"
                IsEnabled="{Binding CanMoveUp}"
                ToolTip.Tip="{ReflectionBinding [ModRow_MoveUpTooltip], Source={StaticResource Loc}}"
                Click="MoveUp_Click"
                CommandParameter="{Binding}">
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
        </Button>

        <!-- Move down (drawn down-chevron). -->
        <Button Classes="icon moveDown"
                IsEnabled="{Binding CanMoveDown}"
                ToolTip.Tip="{ReflectionBinding [ModRow_MoveDownTooltip], Source={StaticResource Loc}}"
                Click="MoveDown_Click"
                CommandParameter="{Binding}">
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
        </Button>

        <!--
          Order-lock toggle (drawn padlock). The locked state reads through
          BOTH shape (closed vs. open padlock) and color: the `selected` class
          (bound to OrderLocked) swaps the button foreground to caution-yellow
          + a caution-yellow fill, and the closed-padlock path is shown. The
          unlocked state shows a neutral open-padlock with a deliberately
          large, obvious shackle opening. Both paths render at 18 DIP. The
          tooltip + automation text are dynamic (lock / unlock).
        -->
        <Button Classes="icon orderLock"
                Classes.selected="{Binding OrderLocked}"
                Click="ToggleOrderLock_Click"
                CommandParameter="{Binding}"
                ToolTip.Tip="{Binding OrderLockTooltip}"
                AutomationProperties.Name="{Binding OrderLockAutomationName}">
          <Panel>
            <!-- Closed padlock (locked): shown when locked. Inherits the
                 caution-yellow foreground from the selected style. -->
            <Path Width="18" Height="18" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding OrderLocked}"
                  Fill="{Binding $parent[Button].Foreground}"
                  Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
            <!--
              Open padlock (unlocked): the closed icon's exact body, corners,
              keyhole, and shackle arch, with only the shackle differing: the
              left leg ends above the body, leaving a clear side gap (the
              right leg stays attached).
            -->
            <Path Width="18" Height="18" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding !OrderLocked}"
                  Fill="{Binding $parent[Button].Foreground}"
                  Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 5h1.9c0-1.16 1.39-2.1 3.1-2.1 1.71 0 3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
          </Panel>
        </Button>

        <!-- Remove (drawn trash). -->
        <Button Classes="icon remove"
                ToolTip.Tip="{ReflectionBinding [ModRow_RemoveTooltip], Source={StaticResource Loc}}"
                Click="Remove_Click"
                CommandParameter="{Binding}">
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
        </Button>

        <!--
          Edit import details (drawn pencil), at the end of the strip. The
          universal correction surface for the row's container: name, source
          association, version tag. Never offered for linked rows (an
          external folder's identity is its path) or download-morphed rows
          (the morph's completion is about to write the container); the
          parent's command repeats both guards.
        -->
        <Button Classes="icon editDetails"
                IsVisible="{Binding CanEditImportDetails}"
                ToolTip.Tip="{ReflectionBinding [ModRow_EditImportDetailsTooltip], Source={StaticResource Loc}}"
                AutomationProperties.Name="{ReflectionBinding [ModRow_EditImportDetailsTooltip], Source={StaticResource Loc}}"
                Click="EditImportDetails_Click"
                CommandParameter="{Binding}">
          <!-- Material "edit" (24x24 source): pencil. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
        </Button>
      </WrapPanel>
    </DataTemplate>

    <!--
      The shared download status content, ONE definition hosted by all three
      download surfaces through ContentControl.ContentTemplate: the Compact
      row's morph slot, the Detailed card's morph slot (both content-bound to
      the row's ActiveDownload), and the appended download row (bound to the
      wrapper itself). The DataContext is the DownloadRowViewModel (the
      row-facing projection of one queue item); phase flags, percent, bytes,
      and the failure message are its derived bindables, all driven by the
      item's own UI-thread notifications. Layout by phase: Queued = status
      word only; Downloading = determinate bar + percent + "12.3 / 27.5 MB"
      (indeterminate bar + received bytes only when the total is unknown);
      Importing = indeterminate bar; Failed = message + Retry + dismiss.
      The Cancel button is NOT here: each host carries it beside this
      content (the morph's action strip and the appended row's own cluster),
      so the two hosts place it without forking the status definition.
    -->
    <DataTemplate x:Key="ModRowDownloadStatusTemplate" x:DataType="vm:DownloadRowViewModel">
      <StackPanel Orientation="Horizontal" Spacing="6"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{Binding AutomationText}">
        <!-- The status word (Queued / Downloading / Importing / Failed). -->
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
        <!-- Determinate bar: Downloading with a known total. -->
        <ProgressBar Width="80" Minimum="0" Maximum="100"
                     Value="{Binding ProgressPercent}"
                     IsVisible="{Binding ShowDeterminateProgress}"
                     VerticalAlignment="Center" />
        <!-- Indeterminate bar: Downloading with an unknown total, or
             Importing. -->
        <ProgressBar Width="60" IsIndeterminate="True"
                     IsVisible="{Binding ShowIndeterminateProgress}"
                     VerticalAlignment="Center" />
        <!-- Whole-number percent label beside the determinate bar. -->
        <TextBlock Text="{Binding PercentText}"
                   IsVisible="{Binding ShowDeterminateProgress}"
                   MinWidth="36" TextAlignment="Right"
                   VerticalAlignment="Center" />
        <!-- Byte progress: "12.3 / 27.5 MB", or received-only when the
             total is unknown. -->
        <TextBlock Text="{Binding BytesText}"
                   IsVisible="{Binding IsDownloading}"
                   FontSize="11" Opacity="0.8"
                   VerticalAlignment="Center" />
        <!-- Failure: the message inline (caution foreground, full text in
             the tooltip) + Retry + dismiss. Shown on both hosts; the row
             returns to normal on dismiss, retry, or the next reload. -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    IsVisible="{Binding IsFailed}"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding FailureText}"
                     Foreground="{DynamicResource CuratorCautionBrush}"
                     TextTrimming="CharacterEllipsis" MaxWidth="320"
                     ToolTip.Tip="{Binding FailureText}"
                     VerticalAlignment="Center" />
          <!-- Retry (drawn refresh arrow, the toolbar refresh icon's
               geometry). -->
          <Button Classes="icon downloadRetry"
                  Command="{Binding RetryCommand}"
                  ToolTip.Tip="{Binding RetryTooltip}"
                  AutomationProperties.Name="{Binding RetryTooltip}">
            <Path Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{Binding $parent[Button].Foreground}"
                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
          </Button>
          <!-- Dismiss (drawn X). -->
          <Button Classes="icon downloadDismiss"
                  Command="{Binding DismissCommand}"
                  ToolTip.Tip="{Binding DismissTooltip}"
                  AutomationProperties.Name="{Binding DismissTooltip}">
            <Path Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{Binding $parent[Button].Foreground}"
                  Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
          </Button>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Source badge: a subtle pill so it reads as metadata, not body text.
         Applies to the HyperlinkButton variant too (the badge is a link). -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The source badge as a clickable link: pill styling carries over from
         Border.badge, plus a transparent background + a pointer-cursor so the
         badge reads as a link when its SourceUrl is set. The HyperlinkButton's
         default theme is a hyperlink (underline, accent color); this override
         restores the pill look. -->
    <Style Selector="HyperlinkButton.badge">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!--
      Compact icon buttons (up / down / trash / update / order-lock): flat,
      inherit foreground.
    -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--
      Order-lock toggle button. The locked state is unmistakable through BOTH
      shape (closed vs. open padlock) and color: a locked button carries a
      low-emphasis caution-yellow selected fill (CuratorCautionBackgroundBrush)
      and a caution-yellow closed-padlock foreground (CuratorCautionBrush);
      pointer-over preserves the clearly-locked yellow fill rather than replacing
      it with the generic list hover. An unlocked button stays transparent at
      rest with a neutral open-padlock + the generic list hover.
    -->
    <Style Selector="Button.orderLock /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.orderLock:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
    </Style>
    <Style Selector="Button.orderLock.selected">
      <Setter Property="Foreground" Value="{DynamicResource CuratorCautionBrush}" />
    </Style>
    <Style Selector="Button.orderLock.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CuratorCautionBackgroundBrush}" />
    </Style>
    <!--
      Locked + pointer-over keeps the caution-yellow fill (selected fill is
      re-asserted here after the unlocked :pointerover rule) so the row never
      loses its clearly-locked treatment while hovered.
    -->
    <Style Selector="Button.orderLock.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CuratorCautionBackgroundBrush}" />
    </Style>
    <!--
      Drag-reorder grip. A 32-DIP transparent, hit-testable surface at the left
      edge of every row; it is the ONLY surface that initiates row reordering.
      Its IsHitTestVisible is bound to the row's IsGripEnabled (false when the row
      is order-locked), so a locked grip stops intercepting pointer input and its
      area falls through to normal touch scrolling. The drawn Material drag-handle
      path stays visible in both states.
    -->
    <Style Selector="Border.reorderGrip">
      <Setter Property="Width" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!--
      Lifted drag row. Once the reorder threshold is crossed the realized
      ItemsControl container (a ContentPresenter) is lifted: a render transform
      (set in code-behind) moves the full-width row to follow the pointer while
      its layout slot stays reserved (rows do not jump), ZIndex raises it above
      siblings, and this class adds an opaque surface + rounded corners + a
      subtle elevation shadow. Background/CornerRadius/BoxShadow are render-only
      (BorderThickness is avoided: it is AffectsMeasure and would shift sibling
      rows). The class is added/removed by the code-behind; the per-move
      transform + ZIndex are restored from a snapshot on every finish/cancel path.
    -->
    <Style Selector="ContentPresenter.liftedRow">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="0 6 16 -4 #80000000" />
    </Style>
    <!--
      The stable Nexus Latest update-action button carries the "updateAction"
      class IN ADDITION to "icon" so a disabled style can be scoped to it alone.
      The button stays visible when no update is available (it is logically
      disabled via UpdateActionEnabled); without this override the inherited
      disabled foreground reads too close to the enabled icon buttons in Fluent.
      The :disabled pseudo-class dims the whole button to 0.4 opacity, so the
      no-update state is unmistakably subdued/grey. Scoped to updateAction only:
      the move/remove icon buttons (which never take this class) are unaffected,
      and the accent-blue ENABLED state is untouched (:disabled is inactive then).
    -->
    <Style Selector="Button.updateAction:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!--
      Density (Compact/Detailed) toolbar buttons. They reuse the compact
      Button.icon shape (small + flat) plus a `density` class whose selected
      state is bound in XAML to DetailedRows.IsCompact / IsDetailed (the shell's
      conditional-class pattern, not a ToggleButton). The selected background
      uses the same Fluent dynamic resource the navItem tiles use so the active
      density reads consistently across the app; pointerover uses the same
      medium-fill resource so hover is distinct on both selected + unselected
      buttons. Defined after `selected` so :pointerover takes precedence when
      hovering a selected button (a more prominent fill, matching navItem).
    -->
    <Style Selector="Button.density /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.density.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
    <Style Selector="Button.density:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
    </Style>
    <!--
      Detailed row card: a rounded low-emphasis Border using Fluent dynamic
      resources. Border + faint background read as a contained card without
      competing with the thumbnail or text. The Detailed root's IsVisible flag
      selects it; this style only carries the chrome.
    -->
    <Style Selector="Border.detailedRow">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>
    <!--
      Detailed card responsive thumbnail + action layout. Each repeated card
      root (Border.detailedRow) carries Container.Name + Container.Sizing=Width
      so it measures its own width; repeated cards share the name. The card Grid
      has three columns (grip, thumbnail, content); these default (wide) styles
      set the large-card state: a 112-DIP thumbnail spanning all three content
      rows in the thumbnail column, and the right-column action strip in the
      content column. Width, height, row span, action column, and action column
      span are set HERE (not as local values on the elements) so the
      ContainerQuery below can override them; local values outrank styles and
      would defeat the query.
    -->
    <Style Selector="Border.detailedThumb">
      <Setter Property="Width" Value="112" />
      <Setter Property="Height" Value="112" />
      <Setter Property="Grid.RowSpan" Value="3" />
    </Style>
    <Style Selector="Path.detailedPlaceholder">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
    </Style>
    <!--
      The shared action strip's Detailed spacing: the WrapPanel root of the
      ModRowActionStripTemplate. Set HERE (not as a local value on the panel)
      so the Compact override below can replace it; local values outrank
      styles and would defeat the per-density difference. Grid placement of
      the strip comes from the ContentControl.detailedActions styles (the
      hosting ContentControl is the card grid child).
    -->
    <Style Selector="WrapPanel.actionStrip">
      <Setter Property="ItemSpacing" Value="8" />
      <Setter Property="LineSpacing" Value="6" />
    </Style>
    <Style Selector="ContentControl.detailedActions">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <!--
      Constrained state (card width at or below 680 DIP): the thumbnail shrinks
      to 72 DIP and spans only name + summary; the single action strip moves to
      a full-width row beneath all three columns. The query targets descendants
      of the named card root, never the queried Border itself, so the card chrome
      is untouched. Declared after the wide defaults so its setters win while the
      query is active.
    -->
    <ContainerQuery Name="detailedModRow" Query="max-width:680">
      <Style Selector="Border.detailedThumb">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Grid.RowSpan" Value="2" />
      </Style>
      <Style Selector="Path.detailedPlaceholder">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
      </Style>
      <Style Selector="ContentControl.detailedActions">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
      </Style>
    </ContainerQuery>
    <!--
      The Compact row's strip spacing: the same shared strip with the
      single-line row's tighter inter-control margins (12 / 12 / 8 / 8 / 4 /
      4 / 4, with ItemSpacing 0 so the margins alone define the gaps). Scoped
      under the Compact root's Grid.compactRow class so the Detailed card is
      untouched, and declared after the WrapPanel.actionStrip base so the
      override wins.
    -->
    <Style Selector="Grid.compactRow WrapPanel.actionStrip">
      <Setter Property="ItemSpacing" Value="0" />
    </Style>
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > CheckBox">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > StackPanel">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > Panel.updateCell">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > Button.moveUp">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > Button.moveDown">
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > Button.orderLock">
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > Button.remove">
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > Button.editDetails">
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <!--
      The morph's download Cancel in the Compact strip: the same left margin
      the (collapsed) update-action cell and Move Up carry, so the single-line
      rhythm is unchanged while a download morphs the row.
    -->
    <Style Selector="Grid.compactRow WrapPanel.actionStrip > Button.downloadCancel">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <!--
      The join-pulse flash: when a dedupe join pulses an item, its host row
      (either host: the Compact root, the Detailed card, or an appended
      download row) briefly lights a subdued background and fades it back out
      over ~0.9s. Driven by the wrapper's IsPulsed flag (bound to each root's
      downloadPulse class, the shell's conditional-class pattern); the
      animation's default no-fill returns the background to the style value
      when it completes, and the VM decays the flag so a later join can
      re-light the class. Modest by design: the point is "the second click
      visibly registered", nothing more. Two selector groups (the Grid roots
      and the Detailed card's Border root) because the animated property is
      Panel.Background vs. Border.Background.
    -->
    <Style Selector="Grid.compactRow.downloadPulse, Grid.downloadRow.downloadPulse">
      <Style.Animations>
        <Animation Duration="0:0:0.9">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightBaseMediumLowBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="Transparent" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.detailedRow.downloadPulse">
      <Style.Animations>
        <Animation Duration="0:0:0.9">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightBaseMediumLowBrush}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="Transparent" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <!--
    The active profile's mod list: header (title + rate-limit notice +
    check-now refresh + Add split button) over a scrollable row
    list. The no-profile handoff (a HyperlinkButton to Profiles) is owned by
    the shell in MainWindow.axaml and overlays this page only when there is no
    active profile; this view never paints its own no-profile text. The whole
    content area is a drag-and-drop target (folders + archives), so mods can be
    added by dropping as well as via the Add split button's archive + folder
    pickers. The folder picker covers users who prefer a picker over
    drag-and-drop; the drag-and-drop hint surfaces in the no-mods empty state
    + the content-area tooltip. Row interactions route through code-behind
    handlers to the parent VM's commands (the established ManageProfilesWindow
    pattern), passing the row as CommandParameter.

    The row list lives inside a borderless edge-spanning ScrollViewer (the
    scrollbar sits at the destination's right edge): the page-level Grid carries
    only vertical margins so the toolbar + the row content keep their safe left
    + right insets without moving the scrollbar off the edge. Horizontal
    scrolling is disabled (rows wrap their content rather than extending the
    page).

    Icons + markers are drawn <Path> geometry (Material 24x24 source) and
    Ellipse, never Unicode glyphs, per AGENTS.md. The SplitButton's arrow is
    built-in theme chrome, not an authored glyph.
  -->

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- Header: check-now refresh + rate-limit notice + search box +
         Compact/Detailed density selector with the hide-disabled +
         updates-only filters + Add split button (hidden until a profile is
         active). The destination
         title lives in the global shell header; this toolbar shows only the
         Mods-specific actions. Refresh is first; the rate-limit notice follows
         it and occupies the single flexible (*) column so the pill keeps its
         content width at wide widths while the column still gives it a finite
         constraint for ellipsis at narrow widths (its full text stays in the
         tooltip), never pushing the search box, the density pair, or Add out.
         The fixed-width search box sits between the flexible column and the
         density pair; the density pair sits adjacent immediately before Add.
         The toolbar carries the page's safe left + right insets (the row
         ScrollViewer below spans to the destination edge so its scrollbar sits
         at the edge, not inset). -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
          IsVisible="{Binding HasActiveProfile}"
          Margin="20,12,20,8">
      <!--
        Rate-limit notice. Occupies the toolbar's flexible (*) column: the pill
        keeps its content width at normal/wide widths (HorizontalAlignment=Left),
        while the star column still gives the Border a finite measure constraint
        so its inner Grid (Auto dot, * text) can ellipsize the notice text at
        narrow widths rather than pushing the density pair or Add out of the
        toolbar. The full RateLimitedNoticeText stays available in the tooltip.
        Collapses entirely when no rate limit is active; the * column then reads
        as the normal gap between refresh and the right-side actions (the same
        gap the old empty spacer column provided).
      -->
      <Border Grid.Column="1"
              Classes="rateLimitedNotice"
              IsVisible="{Binding IsRateLimitActive}"
              Background="{DynamicResource CuratorCautionBackgroundBrush}"
              CornerRadius="8"
              Padding="6,1"
              Margin="8,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              ToolTip.Tip="{Binding RateLimitedTooltip}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
          <Ellipse Grid.Column="0" Width="6" Height="6"
                   Fill="{DynamicResource CuratorCautionBrush}"
                   VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding RateLimitedNoticeText}"
                     TextTrimming="CharacterEllipsis"
                     FontSize="11" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <!--
        Manual "check for updates now": a refresh-affordance button (drawn
        refresh-arrow Path, no glyph), always visible (independent of the
        periodic-check toggle). Click routes through code-behind to the VM's
        CheckForUpdatesNow command, which fires an immediate THOROUGH check
        (the per-mod pass that also catches mods outside the Month window) +
        drives the IsCheckingNow affordance while it runs. The result lands via
        the existing CheckCompleted subscription. The button stays visible at
        all times; it disables while a thorough check is in flight
        (IsCheckingNow), while the manual sliding-window throttle is active, OR
        while an active rate limit has not yet reset (IsRefreshEnabled covers all
        three), and an indeterminate progress spinner overlays the refresh icon
        for the duration. The tooltip is the VM's ManualRefreshTooltip: the
        normal "check for updates now" string normally, the rate-limit message
        while a rate limit is active (server-driven, takes precedence), or the
        live m:ss countdown ("Rate limiting protection enabled. Manual refresh
        will be available again in {time}.") while the manual throttle is active.
      -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                  VerticalAlignment="Center">
        <Button Classes="icon"
                Click="RefreshUpdates_Click"
                IsEnabled="{Binding IsRefreshEnabled}"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding ManualRefreshTooltip}">
          <!-- Material "refresh" (24x24 source): drawn geometry, themed via the
               button foreground. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
        </Button>
        <!-- Indeterminate progress while the thorough check runs (multiple API
             calls, a few seconds). Sits beside the (visible but disabled)
             refresh button; IsVisible=False collapses it out of layout when no
             check is running so the button stands alone. -->
        <ProgressBar Width="18" Height="18"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsCheckingNow}"
                     VerticalAlignment="Center" />
      </StackPanel>
      <!--
        Search box. A fixed-width TextBox between the flexible rate-limit
        column and the density pair; TwoWay binding to SearchText is
        keystroke-live (the projection rebuilds per keystroke). The inner
        clear affordance reuses the Fluent theme's own text-box clear-button
        chrome (FluentTextBoxButton, the same ControlTheme the theme's
        built-in clearButton class applies) with the theme's drawn X geometry;
        it is visible only while search text is present and invokes the
        TextBox's own Clear method (no code-behind; the theme's button is
        Focusable=False so the box keeps focus after the click).
      -->
      <TextBox Grid.Column="2"
               Width="200"
               Margin="16,0,0,0"
               VerticalAlignment="Center"
               Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="{ReflectionBinding [ModList_SearchWatermark], Source={StaticResource Loc}}">
        <TextBox.InnerRightContent>
          <Button Theme="{StaticResource FluentTextBoxButton}"
                  Command="{Binding $parent[TextBox].Clear}"
                  ClipToBounds="True"
                  IsVisible="{Binding HasSearchText}"
                  ToolTip.Tip="{ReflectionBinding [ModList_ClearSearchTooltip], Source={StaticResource Loc}}"
                  AutomationProperties.Name="{ReflectionBinding [ModList_ClearSearchTooltip], Source={StaticResource Loc}}">
            <PathIcon Width="10" Height="10"
                      Data="{StaticResource TextBoxClearButtonData}" />
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>
      <!--
        Compact / Detailed density selector + the hide-disabled and
        updates-only filter toggles. Two adjacent drawn-icon density buttons
        immediately before Add; the active one
        carries the `selected` class (bound to DetailedRows.IsCompact /
        IsDetailed, the shell's conditional class pattern) so the current
        density is visibly distinct. Clicking a button runs
        DetailedRows.SetDensityCommand with the ModRowDensity enum value as its
        parameter; the coordinator normalizes, persists, and reprocesses rows.
        A click on the already-active density is a strict no-op (the
        coordinator's value-equal guard), so the buttons stay enabled. The
        compact-icon shape comes from the `icon` class; the `density` class
        carries the selected/pointerover background chrome. Icons are Material
        24x24 source: view_headline (four dense lines) for Compact, view_agenda
        (two stacked blocks) for Detailed, so the two read as distinct
        densities rather than two near-identical lists. The hide-disabled
        visibility toggle (same icon/density chrome, selected while hiding)
        filters the row list to enabled mods only, and the trailing
        updates-only toggle narrows the list to rows flagged with an available
        update.
      -->
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                   VerticalAlignment="Center" Margin="16,0,0,0">
        <Button Classes="icon density"
                Classes.selected="{Binding DetailedRows.IsCompact}"
                Command="{Binding DetailedRows.SetDensityCommand}"
                CommandParameter="{x:Static config:ModRowDensity.Compact}"
                ToolTip.Tip="{ReflectionBinding [ModList_CompactRowsTooltip], Source={StaticResource Loc}}"
                AutomationProperties.Name="{ReflectionBinding [ModList_CompactRowsTooltip], Source={StaticResource Loc}}">
          <!-- Material "view_headline" (24x24 source): four dense lines. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M4 15h16v-2H4v2zm0 4h16v-2H4v2zm0-8h16V9H4v2zm0-6v2h16V5H4z" />
        </Button>
        <Button Classes="icon density"
                Classes.selected="{Binding DetailedRows.IsDetailed}"
                Command="{Binding DetailedRows.SetDensityCommand}"
                CommandParameter="{x:Static config:ModRowDensity.Detailed}"
                ToolTip.Tip="{ReflectionBinding [ModList_DetailedRowsTooltip], Source={StaticResource Loc}}"
                AutomationProperties.Name="{ReflectionBinding [ModList_DetailedRowsTooltip], Source={StaticResource Loc}}">
          <!-- Material "view_agenda" (24x24 source): two stacked blocks. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M20 3H3c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h17c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zm0 10H3c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h17c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1z" />
        </Button>
        <!--
          Hide-disabled filter toggle. Same icon/density chrome; the selected
          class tracks HideDisabledMods (the shell's conditional-class pattern).
          The icon reads through shape like the order lock reads through color:
          Material "visibility_off" (crossed-out eye) while hiding, Material
          "visibility" (open eye) while showing all. The tooltip + automation
          name describe the action the click performs (hide vs. show).
        -->
        <Button Classes="icon density"
                Classes.selected="{Binding HideDisabledMods}"
                Command="{Binding ToggleHideDisabledCommand}"
                Margin="8,0,0,0"
                ToolTip.Tip="{Binding HideDisabledTooltip}"
                AutomationProperties.Name="{Binding HideDisabledTooltip}">
          <Panel>
            <!-- Material "visibility_off" (24x24 source): shown while the
                 filter hides disabled mods. -->
            <Path Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding HideDisabledMods}"
                  Fill="{Binding $parent[Button].Foreground}"
                  Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 21 21 19.73 3.27 2 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" />
            <!-- Material "visibility" (24x24 source): shown while all rows are
                 visible. -->
            <Path Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding !HideDisabledMods}"
                  Fill="{Binding $parent[Button].Foreground}"
                  Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
          </Panel>
        </Button>
        <!--
          Updates-only filter toggle. Same icon/density chrome but ONE stable
          glyph (updates-only has no natural crossed-out variant to swap), so
          the active state reads through the `selected` class alone (the
          density selector's pattern). The tooltip + automation name describe
          the action the click performs (filter to flagged rows vs. show all).
        -->
        <Button Classes="icon density"
                Classes.selected="{Binding ShowUpdatesOnly}"
                Command="{Binding ToggleUpdatesOnlyCommand}"
                ToolTip.Tip="{Binding UpdatesOnlyTooltip}"
                AutomationProperties.Name="{Binding UpdatesOnlyTooltip}">
          <!-- Material "update" (24x24 source): a circular arrow with a down arrow,
               the toolbar's updates-only filter toggle. -->
          <Path Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{Binding $parent[Button].Foreground}"
                Data="M21,10.12h-6.78l2.74-2.82c-2.73-2.7-7.15-2.8-9.88-0.1c-2.73,2.71-2.73,7.08,0,9.79s7.15,2.71,9.88,0 C18.32,15.65,19,14.08,19,12.1h2c0,1.98-0.88,4.55-2.64,6.29c-3.51,3.48-9.21,3.48-12.72,0c-3.5-3.47-3.53-9.11-0.02-12.58 s9.14-3.47,12.65,0L21,3V10.12z M12.5,8v4.25l3.5,2.08l-0.72,1.21L11,13V8H12.5z" />
        </Button>
      </StackPanel>
      <!--
        Add split button: primary click runs the current mode's action; the
        arrow opens the flyout. All four flyout items are modes that set
        themselves as the default on click (the face label tracks the mode via
        AddModeLabel): "Add Nexus Mods" (the default; opens the Darktide Nexus
        Mods games page in the browser), "Add Mod (archive)", "Add Mod (folder)"
        (separate because a native picker cannot mix files + folders), and "Link
        external folder". The arrow is built-in theme chrome (no authored glyph).
        Disabled while the inline import workflow is active (editing, processing,
        or failure): the VM's StartBatch gate is the final defense, but the
        disabled button communicates the state visually. Also disabled inside a
        Steam Deck Gaming Mode session (the picker-based add paths are unusable
        there); IsAddEnabled covers both, the tooltip carries the Gaming Mode
        guidance while disabled, and the toolbar hint below explains without
        hover.
      -->
      <SplitButton Grid.Column="4"
                   Click="Add_Click"
                   ToolTip.Tip="{Binding AddButtonTooltip}"
                   ToolTip.ShowOnDisabled="True"
                   IsEnabled="{Binding IsAddEnabled}"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center">
        <SplitButton.Content>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- Material "add" plus (24x24 source): drawn geometry. -->
            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                  Fill="{Binding $parent[SplitButton].Foreground}"
                  Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
            <TextBlock Text="{Binding AddModeLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </SplitButton.Content>
        <SplitButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="{ReflectionBinding [ModList_AddNexusMods], Source={StaticResource Loc}}"
                      Click="AddNexusMods_Click" />
            <MenuItem Header="{ReflectionBinding [ModList_AddArchive], Source={StaticResource Loc}}"
                      Click="AddArchive_Click" />
            <MenuItem Header="{ReflectionBinding [ModList_AddFolder], Source={StaticResource Loc}}"
                      Click="AddFolder_Click" />
            <MenuItem Header="{ReflectionBinding [ModList_LinkExternalFolder], Source={StaticResource Loc}}"
                      Click="LinkFolder_Click" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
      <!--
        Gaming Mode toolbar hint (Steam Deck): shown only while a Gaming Mode
        session is detected, next to the disabled Add split button. The
        touch/controller-reachable explanation for the whole Add affordance (no
        hover required). Sits in an Auto column, so at the window minimum the
        toolbar grid hard-clips rather than reflowing; Gaming-Mode-only and
        sized to fit with slack at the minimum width.
      -->
      <TextBlock Grid.Column="5"
                 Text="{ReflectionBinding [ModList_AddGamingModeHint], Source={StaticResource Loc}}"
                 IsVisible="{Binding IsGamingMode}"
                 FontSize="11"
                 Opacity="0.6"
                 Margin="12,0,0,0"
                 VerticalAlignment="Center" />
    </Grid>

    <!--
      Inline import card (ImportWorkflowView). Visible only while the workflow
      is active (editing, processing, or failure). Hosted directly below the
      toolbar with the same 20px left/right inset. DataContext is the workflow
      child VM (reached through ModListViewModel.ImportWorkflow); the visibility
      binding stays on the wrapper Panel so it resolves against the mod-list VM's
      context, not the workflow VM's.
    -->
    <Panel Grid.Row="1"
           IsVisible="{Binding ImportWorkflow.IsActive}"
           Margin="20,0,20,4">
      <views:ImportWorkflowView DataContext="{Binding ImportWorkflow}" />
    </Panel>

    <!--
      Alternate mod-manager banner: shown exactly while the active profile has
      an enabled manager mod (the same derivation the launch path hands to
      Relay as its mod-manager flag). Caution language like the rate-limit
      pill, because the manager, not Curator, owns in-game load order while
      active. Not dismissible: it is live state (disable or remove the manager
      mod to clear it), not a notification.
    -->
    <Border Grid.Row="2"
            IsVisible="{Binding IsModManagerActive}"
            Background="{DynamicResource CuratorCautionBackgroundBrush}"
            CornerRadius="8"
            Padding="8,6"
            Margin="20,0,20,4">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <!-- Material "swap_vert" (24x24 source): drawn geometry, themed via
             the caution foreground. -->
        <Path Grid.Column="0"
              Width="16" Height="16" Stretch="Uniform"
              VerticalAlignment="Center"
              Fill="{DynamicResource CuratorCautionBrush}"
              Data="M16 17.01V10h-2v7.01h-3L15 21l4-3.99h-3zM9 3L5 6.99h3v7.01h2V6.99h3L9 3z" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ModManagerBannerText}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!--
      Content area: the drag-and-drop target (AllowDrop/Drop/DragOver stay here
      so drag-and-drop behavior is unchanged). Background="Transparent" is set
      explicitly so the empty area is hit-testable for drops (a Panel/Grid with
      a null Background does not receive drag events on empty space; a
      transparent brush opts in). No behavioral change for populated rows:
      their children handle their own events first.
      Empty states + the row list overlap; visibility selects which shows. The
      no-profile handoff is NOT here: the shell owns it (a HyperlinkButton over
      the Mods panel in MainWindow.axaml) so navigation stays out of this VM.
      The row list is borderless (no rectangle chrome): an edge-spanning
      ScrollViewer (HorizontalScrollBarVisibility=Disabled) so the vertical
      scrollbar sits at the destination's right edge. Rows carry their own
      left + right margins inside the ItemsControl so the action controls have
      a clear right inset without moving the scrollbar off the edge.
    -->
    <Grid Grid.Row="3"
          Background="Transparent"
          DragDrop.AllowDrop="True"
          DragDrop.Drop="OnDrop"
          DragDrop.DragOver="OnDragOver">

      <!--
        No-matches state: an active profile whose full list is non-empty but
        whose visible projection is empty under an active search/filter. Distinct
        from the no-mods empty state below (they are mutually exclusive: while a
        search or filter is active the add hints do not render), styled to match
        it (centered, subdued).
      -->
      <TextBlock IsVisible="{Binding ShowNoMatchesMessage}"
                 Text="{Binding NoMatchesText}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="20,0"
                 Opacity="0.6" />

      <!--
        Empty: active profile with zero or one mod (typically DMF-only right
        after onboarding). The primary hint invites the user to add their own
        mods alongside the framework. The secondary Nexus line shows when
        Curator is the registered nxm:// handler, so the user knows the
        'Vortex' / 'Mod manager download' buttons on Nexus route mods straight
        into the app, or inside a Gaming Mode session, where it reads as the
        Desktop Mode guidance instead (the nxm instruction cannot be followed
        there even when registered). The no-profile state is owned by the
        shell. Suppressed while a search or filter is active (ShowAddModsHint);
        the no-matches state above owns that case.
      -->
      <StackPanel IsVisible="{Binding ShowAddModsHint}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  Margin="20,0">
        <TextBlock Text="{Binding AddModsHintText}"
                   HorizontalAlignment="Center"
                   Opacity="0.6" />
        <TextBlock Text="{Binding NexusHintText}"
                   IsVisible="{Binding ShowNexusHint}"
                   FontSize="11"
                   Opacity="0.6"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!-- The mod rows (the visible projection; rendered when at least one
           row is visible) + the appended download rows (below them, inside
           the same scroll region). The ScrollViewer spans to the destination
           edge so its vertical scrollbar sits at the edge; horizontal
           scrolling is disabled (rows wrap their content rather than
           extending the page). The mod-list ItemsControl carries the page's
           safe left + right insets so the row content + the action controls
           have a clear right inset from the scrollbar. Its ItemsSource is the
           VM's VisibleMods projection: the drag gesture's realized-container
           math (target ranks, marker anchors, lift lookup) is index-aligned
           to this collection, and commits map visible ranks back onto the
           stored order through the planner. The download ItemsControl below
           is a SEPARATE control over a separate collection (DownloadRows, in
           admission order): its rows are never containers of the mod-list
           ItemsControl, never enter VisibleMods, and carry no reorder
           affordances, so download rows can never become drag sources or
           drop targets. Its visibility follows HasListContent (visible
           profile rows OR appended downloads): an empty or no-matches
           profile with a live download still hosts the appended section,
           while the no-matches message above coexists unchanged. No
           rectangle Border around the populated list: the edge-spanning
           ScrollViewer reads as a clean list, not a boxed region. -->
      <ScrollViewer x:Name="ModListScroll"
                    IsVisible="{Binding HasListContent}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0">
        <StackPanel>
          <ItemsControl x:Name="ModListItems" ItemsSource="{Binding VisibleMods}" Margin="20,0">
            <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModItemViewModel">
              <!--
                One row, two mutually exclusive roots selected by the row's
                IsDetailed projection (pushed down by the detailed-rows
                coordinator): the Compact Grid + the Detailed card. The
                grip, badge cluster, and action strip are the shared
                templates; each root supplies only its own layout (grid
                placement, margins, and density). Both roots bind the exact
                same per-row state + route to the exact same code-behind
                handlers, so no action behavior forks between modes. The
                Panel root only hosts the two alternatives (it carries no
                margin of its own); exactly one is visible at a time, and
                each visible root owns its own row spacing (the Compact Grid
                keeps Margin="0,3"; the Detailed Border carries its own
                Margin="0,3").
              -->
              <Panel>
              <!--
                Compact row layout (4 columns): grip | Name | badges | action
                strip. The drag grip is column 0 and is the ONLY surface that
                initiates row reordering; everything else stays touch-scrolling
                surface. The action strip (enabled, policy editor, update
                button, move/remove cluster) is the shared template in one
                Auto column: measured against the full row width, it never
                wraps at reachable widths (the strip's compact margins come
                from the Grid.compactRow styles). The insertion markers span
                every column.
              -->
              <Grid Classes="compactRow"
                    Classes.downloadPulse="{Binding ActiveDownload.IsPulsed}"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    Margin="0,3" MinHeight="32"
                    IsVisible="{Binding !IsDetailed}">

                  <!-- Drag-reorder grip (column 0), the shared template. -->
                  <ContentControl Grid.Column="0"
                                  Content="{Binding}"
                                  ContentTemplate="{StaticResource ModRowGripTemplate}" />

                  <!--
                    Name (column 1) + the download morph slot: while a
                    download morphs the row, the shared download status
                    content follows the name on the same single line (the
                    name keeps the star column and ellipsizes; the morph
                    content takes its natural width at the right edge of
                    the pair).
                  -->
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <ContentControl Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{Binding ActiveDownload}"
                                    ContentTemplate="{StaticResource ModRowDownloadStatusTemplate}"
                                    IsVisible="{Binding IsDownloadMorphed}" />
                  </Grid>

                  <!--
                    Source badge area (column 2): the shared badge cluster.
                    The cell margin (the gap after the name) lives here on
                    the host.
                  -->
                  <ContentControl Grid.Column="2"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="{Binding}"
                                  ContentTemplate="{StaticResource ModRowBadgesTemplate}" />

                  <!--
                    The action strip (column 3): enabled toggle, policy
                    editor, stable update-action cell, and the move / lock /
                    remove cluster, one shared definition. The enabled
                    checkbox shows no label in Compact (EnabledLabel is null
                    for a compact row, so the checkbox carries no text).
                  -->
                  <ContentControl Grid.Column="3"
                                  Content="{Binding}"
                                  ContentTemplate="{StaticResource ModRowActionStripTemplate}" />

                  <!--
                    Drag insertion markers (2-DIP accent line, non-hit-testable).
                    At most one is visible on at most one row while dragging: before
                    the target row for an upward move, after it for a downward move.
                    Spans every column so the line reads across the whole row.
                  -->
                  <Border Grid.ColumnSpan="4"
                          VerticalAlignment="Top" Height="2"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ShowReorderMarkerBefore}"
                          Background="{DynamicResource SystemControlForegroundAccentBrush}" />
                  <Border Grid.ColumnSpan="4"
                          VerticalAlignment="Bottom" Height="2"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ShowReorderMarkerAfter}"
                          Background="{DynamicResource SystemControlForegroundAccentBrush}" />

                </Grid>

                <!--
                  DETAILED row root. A rounded low-emphasis card (Border via the
                  detailedRow style) laid out as one adaptive Grid: column 0 is
                  the drag grip, column 1 is the thumbnail/placeholder slot,
                  column 2 holds the name + source badge (row 0) and the two-line
                  summary (row 1), and row 2 is the action strip. The card root
                  is a named width container (Container.Name +
                  Container.Sizing=Width) so a ContainerQuery in UserControl.Styles
                  swaps the thumbnail size + row span and moves the action strip
                  full-width at the 680-DIP breakpoint. Width, height, row-span,
                  and action-column values that change at the breakpoint come from
                  those styles (not local values, which would outrank styles);
                  constant row/column positions stay local. The grip, badge
                  cluster, and action strip are the SAME shared templates the
                  Compact root hosts, so no action behavior forks between modes.
                  No horizontal ScrollViewer; only the page-level vertical
                  ScrollViewer scrolls.
                -->
                <Border IsVisible="{Binding IsDetailed}"
                        Classes="detailedRow"
                        Classes.downloadPulse="{Binding ActiveDownload.IsPulsed}"
                        Container.Name="detailedModRow"
                        Container.Sizing="Width"
                        Margin="0,3"
                        Padding="12">
                  <Panel>
                  <Grid ColumnDefinitions="Auto,Auto,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="6">
                      <!--
                        Drag-reorder grip (column 0, spans all rows), the
                        shared template. Same surface + contract as the
                        Compact grip: the only row area that initiates
                        reordering; IsHitTestVisible bound to IsGripEnabled
                        so a locked row falls through to touch scrolling. The
                        grip stays at the card's left edge across both wide +
                        constrained layouts.
                      -->
                      <ContentControl Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                      Content="{Binding}"
                                      ContentTemplate="{StaticResource ModRowGripTemplate}" />

                      <!--
                        Thumbnail area (column 1). A rounded, clipped square
                        whose Width, Height, and Grid.RowSpan come from the
                        Border.detailedThumb styles (112 DIP spanning all three
                        rows when wide; 72 DIP spanning name + summary when
                        constrained). Border implements
                        IVisualWithRoundRectClip with ClipToBoundsRadius mapped
                        to CornerRadius, so ClipToBounds clips the child to the
                        rounded boundary. The Image shows only when a thumbnail
                        has been decoded; every no-image case (Untracked/Linked,
                        missing metadata, no auth, offline, failed image, adult
                        flag, empty URL) shows the same neutral drawn-geometry
                        placeholder in the same box. Adult rows never receive a
                        thumbnail (the coordinator skips them), so they fall
                        through to the placeholder here.
                      -->
                      <Border Grid.Row="0" Grid.Column="1"
                              Classes="detailedThumb"
                              CornerRadius="8" ClipToBounds="True"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}">
                        <Panel>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                 IsVisible="{Binding HasThumbnail}" />
                          <!--
                            Neutral placeholder (Material "image", 24x24 source):
                            low-opacity themed foreground so it reads as an empty
                            image slot, not body text. Drawn geometry, not a
                            glyph. Width/Height come from the
                            Path.detailedPlaceholder styles (36 DIP wide; 28 DIP
                            constrained).
                          -->
                          <Path Classes="detailedPlaceholder"
                                Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !HasThumbnail}"
                                Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Opacity="0.6"
                                Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                        </Panel>
                      </Border>

                      <!--
                        Name + source badge (row 0, column 2). A constrained Grid
                        (star name, auto badge) rather than a horizontal
                        StackPanel: the star column bounds the name so it
                        ellipsizes on long names (the full text stays in the
                        tooltip + the automation name), and the badge cluster
                        keeps its natural width. The badge cluster is the shared
                        template (progress + the three mutually-exclusive badge
                        states with the same bindings + OpenFolder_Click
                        handler as Compact).
                      -->
                      <Grid Grid.Row="0" Grid.Column="2"
                            ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Name}"
                                     AutomationProperties.Name="{Binding Name}"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center" />
                          <ContentControl Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Content="{Binding}"
                                          ContentTemplate="{StaticResource ModRowBadgesTemplate}" />
                        </Grid>

                      <!--
                        Summary (row 1, column 2): at most two wrapped lines,
                        safely trimmed. The full text is preserved in the
                        tooltip (when non-null) + the automation name (always,
                        so the fallback text stays reachable by assistive tech
                        even when visually clipped). While a download morphs
                        the row, this swaps for the shared download status
                        content (status word + progress + failure), bound to
                        the row's ActiveDownload wrapper.
                      -->
                      <TextBlock Grid.Row="1" Grid.Column="2"
                                 Text="{Binding SummaryText}"
                                 MaxLines="2" TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding SummaryTooltip}"
                                 AutomationProperties.Name="{Binding SummaryText}"
                                 IsVisible="{Binding !IsDownloadMorphed}" />
                      <ContentControl Grid.Row="1" Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Content="{Binding ActiveDownload}"
                                      ContentTemplate="{StaticResource ModRowDownloadStatusTemplate}"
                                      IsVisible="{Binding IsDownloadMorphed}" />

                      <!--
                        Action strip (row 2), the SAME shared template the
                        Compact root hosts: Enabled (its localized label shows
                        only in Detailed, via the row's density-aware
                        EnabledLabel), the policy editor kept together as one
                        wrap unit, the stable update-action reserved cell, then
                        the move / order-lock / remove cluster. A WrapPanel so
                        the controls wrap at the containing edge at narrow
                        widths (no clip, no horizontal scrolling), right-aligning
                        every wrapped line (ItemsAlignment=End). Grid.Column +
                        Grid.ColumnSpan come from the
                        ContentControl.detailedActions styles (right column only
                        when wide; full width across all columns when
                        constrained), so the container query moves the strip
                        without duplicating it.
                      -->
                      <ContentControl Grid.Row="2"
                                      Classes="detailedActions"
                                      Content="{Binding}"
                                      ContentTemplate="{StaticResource ModRowActionStripTemplate}" />

                  </Grid>
                  <!--
                    Drag insertion markers (2-DIP accent line, non-hit-testable),
                    siblings of the card content so they anchor to the card's
                    inner top/bottom edge. At most one is visible on at most one
                    row while dragging.
                  -->
                  <Border VerticalAlignment="Top" Height="2"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ShowReorderMarkerBefore}"
                          Background="{DynamicResource SystemControlForegroundAccentBrush}" />
                  <Border VerticalAlignment="Bottom" Height="2"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ShowReorderMarkerAfter}"
                          Background="{DynamicResource SystemControlForegroundAccentBrush}" />
                   </Panel>
                 </Border>
              </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!--
            The appended download rows: queue items with no in-place host
            (fresh mods, cross-profile targets, filtered-hidden targets, null
            container ids), in admission order, below the profile rows.
            One row per item: a drawn download arrow, the display name with
            the always-shown "for profile {name}" label, the SAME shared
            download status content the morph hosts, and the item's Cancel.
            No grip, no markers, no move/lock/remove: no reorder affordances.
            A completed row simply vanishes (the item leaves the coordinator
            collection; the completion reload surfaces the real mod row).
            The root Grid carries the join-pulse flash class like the morph
            hosts do.
          -->
          <ItemsControl x:Name="DownloadListItems"
                        ItemsSource="{Binding DownloadRows}"
                        IsVisible="{Binding HasDownloadRows}"
                        Margin="20,8,20,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DownloadRowViewModel">
                <Grid Classes="downloadRow"
                      Classes.downloadPulse="{Binding IsPulsed}"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      Margin="0,3" MinHeight="32"
                      AutomationProperties.Name="{Binding AutomationText}">
                  <!-- Material "download" (24x24 source): the row's
                       activity marker. -->
                  <Path Grid.Column="0"
                        Width="16" Height="16" Stretch="Uniform"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                  <!-- Name + the always-shown target profile label. -->
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DisplayName}" />
                    <TextBlock Text="{Binding ProfileLabel}"
                               FontSize="11" Opacity="0.6"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ProfileLabel}" />
                  </StackPanel>
                  <!-- The shared download status content (status word +
                       progress + failure with Retry + dismiss). -->
                  <ContentControl Grid.Column="2"
                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                  Content="{Binding}"
                                  ContentTemplate="{StaticResource ModRowDownloadStatusTemplate}" />
                  <!-- Cancel (the same drawn icon + command the morph's
                       strip offers). -->
                  <Button Grid.Column="3"
                          Classes="icon downloadCancel"
                          Margin="8,0,0,0"
                          IsEnabled="{Binding CanCancel}"
                          Command="{Binding CancelCommand}"
                          ToolTip.Tip="{Binding CancelTooltip}"
                          AutomationProperties.Name="{Binding CancelTooltip}">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding $parent[Button].Foreground}"
                          Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      </Grid>
  </Grid>
</UserControl>
