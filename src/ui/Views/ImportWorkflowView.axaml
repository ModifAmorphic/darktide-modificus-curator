<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modificus.Curator.UI.ViewModels"
             x:Class="Modificus.Curator.UI.Views.ImportWorkflowView"
             x:DataType="vm:ImportWorkflowViewModel">

  <!--
    The inline local-import card, hosted directly below the Mods toolbar inside
    ModListView. A full-width bordered card with the same 20px left/right inset
    as the toolbar and rows. A vertical sequence of compact label/control rows
    so the card remains usable at the main window minimum width with either
    compact or expanded navigation.

    Four rows: header (position + path), the editing form (visible-but-disabled
    during processing, hidden during failure), the status/failure area
    (processing spinner or the terminal inline error), and the actions row
    (Cancel/Import or Close). Status/failure and actions are in separate rows so
    they never overlap.

    Icons + markers are drawn geometry, never Unicode glyphs, per AGENTS.md.
    No new authored icon is needed here: the actions are text buttons.
  -->

  <!-- The card is visible only while the workflow is active (editing,
       processing, or failure). The host binds this UserControl's IsVisible to
       ImportWorkflow.IsActive. -->
  <Border Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="12,10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

      <!-- Header: "Import mod {n} of {total}" (Auto) + the current source path
           (star, character-ellipsized). The star column constrains the path so
           it cannot make the card overflow; the full path is retained in the
           tooltip + automation name. -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
        <TextBlock Grid.Column="0"
                   Text="{Binding HeaderText}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <TextBlock Grid.Column="1"
                   Text="{Binding CurrentPath}"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.7"
                   VerticalAlignment="Center"
                   ToolTip.Tip="{Binding CurrentPath}"
                   AutomationProperties.Name="{Binding CurrentPath}" />
      </Grid>

      <!--
        Editing form: a vertical sequence of compact label/control rows over a
        single two-column grid (120px label, star control). Visible when editing
        and processing (disabled during processing so the card does not shift);
        hidden during failure. Conditional Nexus-only rows (Version, URL/ID,
        policy) collapse cleanly for Untracked.
      -->
      <Grid Grid.Row="1"
            ColumnDefinitions="120,*"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            IsVisible="{Binding !IsFailure}"
            IsEnabled="{Binding IsEditing}"
            Margin="0,0,0,8">

        <!-- Row 0: Mod name. -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="{ReflectionBinding [Import_NameLabel], Source={StaticResource Loc}}"
                   VerticalAlignment="Center"
                   Margin="0,0,6,4" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding ModName, Mode=TwoWay}"
                 Margin="0,0,0,4" />

        <!-- Row 1: Source. -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="{ReflectionBinding [Import_SourceLabel], Source={StaticResource Loc}}"
                   VerticalAlignment="Center"
                   Margin="0,0,6,4" />
        <ComboBox Grid.Row="1" Grid.Column="1"
                  SelectedIndex="{Binding SourceChoiceIndex, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,4">
          <ComboBoxItem Content="{ReflectionBinding [Import_SourceUntracked], Source={StaticResource Loc}}" />
          <ComboBoxItem Content="{ReflectionBinding [Import_SourceNexus], Source={StaticResource Loc}}" />
        </ComboBox>

        <!-- Row 2: Version (Nexus only). A vertical stack: TextBox then its
             inline validation message, both under the same label. Collapses
             for Untracked. -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="{ReflectionBinding [Import_VersionLabel], Source={StaticResource Loc}}"
                   VerticalAlignment="Top"
                   Margin="0,0,6,4"
                   IsVisible="{Binding IsRemote}" />
        <StackPanel Grid.Row="2" Grid.Column="1"
                    Orientation="Vertical"
                    Margin="0,0,0,4"
                    IsVisible="{Binding IsRemote}">
          <TextBox Text="{Binding Version, Mode=TwoWay}"
                   PlaceholderText="{ReflectionBinding [Import_VersionRequired], Source={StaticResource Loc}}" />
          <TextBlock Text="{Binding VersionValidationMessage}"
                     FontSize="11"
                     Margin="0,2,0,0"
                     Foreground="{DynamicResource CuratorCautionBrush}"
                     IsVisible="{Binding VersionValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Row 3: Mod URL or ID (Nexus only). Same vertical-stack shape. -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="{Binding UrlLabel}"
                   VerticalAlignment="Top"
                   Margin="0,0,6,4"
                   IsVisible="{Binding IsRemote}" />
        <StackPanel Grid.Row="3" Grid.Column="1"
                    Orientation="Vertical"
                    Margin="0,0,0,4"
                    IsVisible="{Binding IsRemote}">
          <TextBox Text="{Binding Url, Mode=TwoWay}"
                   PlaceholderText="{Binding UrlPlaceholder}" />
          <TextBlock Text="{Binding UrlValidationMessage}"
                     FontSize="11"
                     Margin="0,2,0,0"
                     Foreground="{DynamicResource CuratorCautionBrush}"
                     IsVisible="{Binding UrlValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Row 4: Version policy (Nexus only). -->
        <TextBlock Grid.Row="4" Grid.Column="0"
                   Text="{ReflectionBinding [Import_PolicyLabel], Source={StaticResource Loc}}"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"
                   IsVisible="{Binding IsRemote}" />
        <ComboBox Grid.Row="4" Grid.Column="1"
                  SelectedIndex="{Binding PolicyChoiceIndex, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsRemote}">
          <ComboBoxItem Content="{ReflectionBinding [Import_PolicyLatest], Source={StaticResource Loc}}" />
          <ComboBoxItem Content="{ReflectionBinding [Import_PolicyPinned], Source={StaticResource Loc}}" />
        </ComboBox>
      </Grid>

      <!--
        Status/failure area (row 2). Processing: localized text + indeterminate
        ProgressBar. Failure: the derived inline FailureMessage (wraps, no
        horizontal scroll). The two are mutually exclusive; neither shows while
        editing. The actions are in a separate row (row 3) so they never
        overlap this area.
      -->
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="{Binding IsProcessing}"
                  Margin="0,0,0,4">
        <ProgressBar Width="18" Height="18"
                     IsIndeterminate="True"
                     VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProcessingText}"
                   VerticalAlignment="Center"
                   Opacity="0.8" />
      </StackPanel>

      <TextBlock Grid.Row="2"
                 Text="{Binding FailureMessage}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource CuratorCautionBrush}"
                 IsVisible="{Binding IsFailure}"
                 Margin="0,0,0,4" />

      <!--
        Actions (row 3), right-aligned. Editing: Cancel batch + accent Import.
        Failure: Close only. Processing: both hidden (the disabled editing form
        above is the focus). Editing buttons and failure Close are mutually
        visible by state (IsEditing vs IsFailure).
      -->
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding !IsProcessing}">
        <Button Content="{ReflectionBinding [ImportWorkflow_CancelBatch], Source={StaticResource Loc}}"
                Command="{Binding CancelBatchCommand}"
                IsVisible="{Binding IsEditing}" />
        <Button Content="{ReflectionBinding [ImportWorkflow_Import], Source={StaticResource Loc}}"
                Command="{Binding ImportCurrentCommand}"
                Classes="accent"
                IsVisible="{Binding IsEditing}" />
        <Button Content="{ReflectionBinding [ImportWorkflow_Close], Source={StaticResource Loc}}"
                Command="{Binding CloseFailureCommand}"
                IsVisible="{Binding IsFailure}" />
      </StackPanel>

    </Grid>
  </Border>
</UserControl>
