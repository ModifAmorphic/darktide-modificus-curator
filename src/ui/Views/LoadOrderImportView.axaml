<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modificus.Curator.UI.ViewModels"
             x:Class="Modificus.Curator.UI.Views.LoadOrderImportView"
             x:DataType="vm:LoadOrderImportViewModel">

  <!--
    The load-order review table, hosted below the import-workflow card inside
    ModListView (the two cards are mutually exclusive; this one is always the
    top-below-toolbar card, never an in-row band). A full-width bordered card
    with the same 20px left/right inset as the toolbar + rows.

    The table is a compact list of ordinary controls (NOT a DataGrid; the repo
    has no such package): a header row + one row per parsed file line, over
    the shared column layout
    (file name | match | outcome | include | mod id | version | find).
    The mod id + version columns are RESERVED for the resolver tiers that
    activate those cells later: the columns exist in the header + row
    definitions (fixed widths, empty cell regions) so activating them never
    reshuffles the table. Unresolved rows carry the open-on-Nexus link in the
    last column; resolved rows leave it empty.

    The include defaults ride in with the rows (reorder included, add
    excluded, unresolved disabled); Apply needs at least one included line.
    Icons + markers are drawn geometry, never Unicode glyphs, per AGENTS.md.
  -->

  <!-- The host (a wrapper Panel in ModListView) gates this UserControl's
       visibility to the card's IsActive; this control assumes it is only
       realized while a review session is open. -->
  <Border Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="12,10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

      <!-- Header: the card title + the picked file's path (star column,
           ellipsized; the full path stays in the tooltip + automation
           name). -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
        <TextBlock Grid.Column="0"
                   Text="{ReflectionBinding [LoadOrder_Title], Source={StaticResource Loc}}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <TextBlock Grid.Column="1"
                   Text="{Binding SourcePath}"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.7"
                   VerticalAlignment="Center"
                   ToolTip.Tip="{Binding SourcePath}"
                   AutomationProperties.Name="{Binding SourcePath}" />
      </Grid>

      <!-- The table: header labels + the row list. The ColumnDefinitions are
           duplicated between the header and the row template BY DESIGN (the
           fixed widths keep the reserved resolver columns laid out even while
           their cells are empty); a source-scan test pins the two strings
           identical so they cannot drift. -->
      <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,0,0,8">

        <!-- The header row. The mod id + version headers label the reserved
             columns (their cells activate with the resolver tiers). -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,*,Auto,Auto,110,80,Auto"
              Opacity="0.7"
              MinHeight="24">
          <TextBlock Grid.Column="0"
                     Text="{ReflectionBinding [LoadOrder_FileNameHeader], Source={StaticResource Loc}}"
                     FontSize="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{ReflectionBinding [LoadOrder_MatchHeader], Source={StaticResource Loc}}"
                     FontSize="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="{ReflectionBinding [LoadOrder_OutcomeHeader], Source={StaticResource Loc}}"
                     FontSize="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3"
                     Text="{ReflectionBinding [LoadOrder_IncludeHeader], Source={StaticResource Loc}}"
                     FontSize="11" VerticalAlignment="Center"
                     HorizontalAlignment="Center" />
          <TextBlock Grid.Column="4"
                     Text="{ReflectionBinding [LoadOrder_ModIdHeader], Source={StaticResource Loc}}"
                     FontSize="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="5"
                     Text="{ReflectionBinding [LoadOrder_VersionHeader], Source={StaticResource Loc}}"
                     FontSize="11" VerticalAlignment="Center" />
        </Grid>

        <!-- The rows: one per parsed file line, in file order. Bounded height
             so a long file scrolls inside the card instead of stretching the
             page. -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="320"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LoadOrderRowViewModel">
                <StackPanel>
                <Grid ColumnDefinitions="*,*,Auto,Auto,110,80,Auto"
                      MinHeight="28"
                      Margin="0,1">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding MatchText}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             ToolTip.Tip="{Binding MatchText}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding OutcomeText}" VerticalAlignment="Center" />
                    <!-- The search spinner: an indeterminate bar while this
                         row's search runs (the serial queue processes one row
                         at a time, so at most one spinner shows). -->
                    <ProgressBar Width="16" Height="10"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsSearching}"
                                 VerticalAlignment="Center" />
                  </StackPanel>
                  <CheckBox Grid.Column="3"
                            IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                            IsEnabled="{Binding IsIncludeEnabled}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                  <!-- Columns 4 + 5: the identification cells. For an
                       UNIDENTIFIED row they host the manual id/URL entry
                       (parsed via the shared ImportSourceValidator rules; a
                       bare id or a nexusmods.com URL both accepted) + the
                       Apply button, so the user can identify the row by hand
                       when the search found nothing (or nothing right). For
                       an IDENTIFIED row the cells turn read-only facts: the
                       accepted mod id + the typed version tag (the apply path
                       decides what the version means per destination; it is
                       validated non-empty-when-Nexus like the import form).
                       Resolved rows (reorder/library) keep the cells inert:
                       the repo tier already identified them. -->
                  <Panel Grid.Column="4" VerticalAlignment="Center">
                    <TextBox Text="{Binding ManualId, Mode=TwoWay}"
                             IsVisible="{Binding !AreIdCellsEnabled}"
                             IsEnabled="{Binding IsUnresolved}"
                             PlaceholderText="{ReflectionBinding [LoadOrder_ManualIdHint], Source={StaticResource Loc}}"
                             FontSize="11" />
                    <TextBlock Text="{Binding IdentifiedName}"
                               IsVisible="{Binding AreIdCellsEnabled}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding IdentifiedName}" />
                  </Panel>
                  <!-- The version cell exists only for an identified
                       sibling-import row: it tags the content imported from
                       disk. Rows with no local content carry no version (the
                       Premium download resolves the real one; non-premium
                       visits Nexus), so the column stays empty for them -
                       absent, not disabled. -->
                  <TextBox Grid.Column="5"
                           Text="{Binding Version, Mode=TwoWay}"
                           IsVisible="{Binding IsVersionCellVisible}"
                           PlaceholderText="{ReflectionBinding [LoadOrder_VersionHint], Source={StaticResource Loc}}"
                           FontSize="11" />

                  <!-- Column 6: the row's action. Identified rows expose the
                       identity fact (nothing to accept); identified-by-
                       candidate rows are done, manual rows carry the Apply
                       inside the id cell's flow (the Apply button below).
                       Unidentified rows expose the open-on-Nexus link. -->
                  <Panel Grid.Column="6" VerticalAlignment="Center">
                    <HyperlinkButton IsVisible="{Binding IsUnresolved}"
                                    Click="OpenOnNexus_Click"
                                    CommandParameter="{Binding}">
                      <TextBlock Text="{ReflectionBinding [LoadOrder_SearchOnNexus], Source={StaticResource Loc}}"
                                 FontSize="11" />
                    </HyperlinkButton>
                    <Button Classes="icon"
                            IsVisible="{Binding IsManualPending}"
                            Click="ApplyManualId_Click"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{ReflectionBinding [LoadOrder_ApplyManualTooltip], Source={StaticResource Loc}}"
                            AutomationProperties.Name="{ReflectionBinding [LoadOrder_ApplyManualTooltip], Source={StaticResource Loc}}">
                      <!-- Material "check" (24x24 source): drawn geometry. -->
                      <Path Width="16" Height="16" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Fill="{Binding $parent[Button].Foreground}"
                            Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                    </Button>
                  </Panel>
                </Grid>

                <!-- The identification workspace: an unresolved row with
                     search candidates shows the TOP candidate inline (name +
                     mod id + a one-click Accept); an expand affordance
                     reveals the alternates (up to the candidate cap), each
                     with its own accept. The workspace never checks the
                     include checkbox: identification is a correction of WHAT
                     the line is, not consent to include it. -->
                <StackPanel IsVisible="{Binding ShowCandidateWorkspace}" Spacing="2"
                            Margin="8,0,0,2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding TopCandidate.Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="240"
                               ToolTip.Tip="{Binding TopCandidate.Name}" />
                    <Button Click="AcceptCandidate_Click" CommandParameter="{Binding}">
                      <TextBlock Text="{ReflectionBinding [LoadOrder_AcceptCandidate], Source={StaticResource Loc}}"
                                 FontSize="11" />
                    </Button>
                    <Button Classes="icon"
                            IsVisible="{Binding HasAlternateCandidates}"
                            Click="ToggleAlternates_Click"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{ReflectionBinding [LoadOrder_ShowAlternatesTooltip], Source={StaticResource Loc}}"
                            AutomationProperties.Name="{ReflectionBinding [LoadOrder_ShowAlternatesTooltip], Source={StaticResource Loc}}">
                      <!-- Material "expand_more" (24x24): the expand chevron,
                           rotated when collapsed via the style below. -->
                      <Path Width="16" Height="16" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Fill="{Binding $parent[Button].Foreground}"
                            Data="M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z" />
                    </Button>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding AlternateCandidates}"
                                IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NexusSearchCandidate">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" MaxWidth="240"
                                     ToolTip.Tip="{Binding Name}" />
                          <Button Click="AcceptAlternate_Click">
                            <TextBlock Text="{ReflectionBinding [LoadOrder_AcceptCandidate], Source={StaticResource Loc}}"
                                       FontSize="11" />
                          </Button>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- The per-line apply failure (a failed sibling import, or a
                     download resolve that produced no item): the apply
                     continued past it; the message states what did not land
                     so a re-run can finish it. -->
                <TextBlock Text="{Binding LineFailure}"
                           IsVisible="{Binding LineFailure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="11"
                           Foreground="{DynamicResource CuratorCautionBrush}"
                           TextWrapping="Wrap"
                           Margin="8,0,0,2" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- The empty-file notice + the apply failure share the status row;
           both are mutually exclusive with a populated, healthy table. -->
      <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,4">
        <TextBlock Text="{ReflectionBinding [LoadOrder_EmptyNotice], Source={StaticResource Loc}}"
                   IsVisible="{Binding ShowEmptyNotice}"
                   TextWrapping="Wrap"
                   Opacity="0.7" />
        <TextBlock Text="{Binding ApplyFailure}"
                   IsVisible="{Binding ApplyFailure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource CuratorCautionBrush}" />
      </StackPanel>

      <!-- Actions, right-aligned: Cancel + accent Apply. The table was the
           review; Apply confirms nothing further. Both disable while the
           apply runs (IsApplying; the card stays active, holding the card
           gate + the toolbar lock through the apply). Own grid row: the
           status area above can wrap to any height without rendering under
           the buttons. -->
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,4,0,0">
        <Button Content="{ReflectionBinding [LoadOrder_CancelButton], Source={StaticResource Loc}}"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding CanCancelNow}"
                MinWidth="80" />
        <Button Content="{ReflectionBinding [LoadOrder_ApplyButton], Source={StaticResource Loc}}"
                Command="{Binding ApplyCommand}"
                IsEnabled="{Binding CanApplyNow}"
                Classes="accent"
                MinWidth="80" />
      </StackPanel>

    </Grid>
  </Border>
</UserControl>
