<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Modificus.Curator.UI.Views"
        x:Class="Modificus.Curator.UI.Views.ProgressDialog"
        Title="{ReflectionBinding [Dmf_Downloading], Source={StaticResource Loc}}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        Width="420" MinWidth="320"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!--
    A modal spinner shown while a short async operation is in flight (the app
    self-update download; mod downloads render as rows on the mod list instead,
    through the download queue). The message is set once before the dialog is
    shown and does not change, so SizeToContent="Height" (honored at show time
    in Avalonia 12.x) sizes the window to its content at the current font
    scale. There are no buttons: the DialogService closes the window from the
    work's continuation (the work cannot be cancelled mid-flight; a partial
    result is useless). The drawn title bar's close button is hidden by
    DialogTitleBar.ShowClose="false" so the user cannot dismiss the spinner
    while the work is running. The window title reuses the Dmf_Downloading
    string (the dialog predates its generalization).
  -->
  <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1">
    <Grid RowDefinitions="Auto,*">

      <views:DialogTitleBar Grid.Row="0" ShowClose="False" />

      <Border Grid.Row="1" Padding="24">
        <StackPanel Spacing="16">
          <TextBlock x:Name="MessageText"
                     TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True"
                       IsHitTestVisible="False" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
